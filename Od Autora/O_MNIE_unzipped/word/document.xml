="00512C39"><w:rPr><w:rFonts w:ascii="Times New Roman" w:eastAsia="Times New Roman" w:hAnsi="Times New Roman"/><w:color w:val="auto"/><w:sz w:val="24"/><w:szCs w:val="24"/><w:u w:val="none"/><w:lang w:val="pl-PL" w:eastAsia="de-DE"/></w:rPr><w:t xml:space="preserve"> znika, ustępując miejsca autentyczności, a odwaga do mówienia o własnych potrzebach staje się Twoim naturalnym stanem i fundamentem codziennego </w:t></w:r><w:r w:rsidR="009A3DAD"><w:rPr><w:rFonts w:ascii="Times New Roman" w:eastAsia="Times New Roman" w:hAnsi="Times New Roman"/><w:color w:val="auto"/><w:sz w:val="24"/><w:szCs w:val="24"/><w:u w:val="none"/><w:lang w:val="pl-PL" w:eastAsia="de-DE"/></w:rPr><w:t>życia</w:t></w:r><w:r w:rsidRPr="00512C39"><w:rPr><w:rFonts w:ascii="Times New Roman" w:eastAsia="Times New Roman" w:hAnsi="Times New Roman"/><w:color w:val="auto"/><w:sz w:val="24"/><w:szCs w:val="24"/><w:u w:val="none"/><w:lang w:val="pl-PL" w:eastAsia="de-DE"/></w:rPr><w:t xml:space="preserve">. </w:t></w:r></w:p><w:p w14:paraId="5A1FBE57" w14:textId="77777777" w:rsidR="00512C39" w:rsidRPr="00512C39" w:rsidRDefault="00512C39" w:rsidP="00512C39"><w:pPr><w:spacing w:before="100" w:beforeAutospacing="1" w:after="100" w:afterAutospacing="1" w:line="240" w:lineRule="auto"/><w:rPr><w:rFonts w:ascii="Times New Roman" w:eastAsia="Times New Roman" w:hAnsi="Times New Roman"/><w:color w:val="auto"/><w:sz w:val="24"/><w:szCs w:val="24"/><w:u w:val="none"/><w:lang w:val="pl-PL" w:eastAsia="de-DE"/></w:rPr></w:pPr><w:r w:rsidRPr="00512C39"><w:rPr><w:rFonts w:ascii="Times New Roman" w:eastAsia="Times New Roman" w:hAnsi="Times New Roman"/><w:color w:val="auto"/><w:sz w:val="24"/><w:szCs w:val="24"/><w:u w:val="none"/><w:lang w:val="pl-PL" w:eastAsia="de-DE"/></w:rPr><w:t xml:space="preserve">Nie musisz już iść przez życie po omacku. Twoje liczby i Twoje emocje niosą odpowiedzi, których szukasz, by w końcu głęboko odetchnąć i z czułością przyjąć każdą część siebie. </w:t></w:r></w:p><w:p w14:paraId="0ED5F330" w