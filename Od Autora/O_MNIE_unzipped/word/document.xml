<w:document xmlns:wpc="http://schemas.microsoft.com/office/word/2010/wordprocessingCanvas" xmlns:cx="http://schemas.microsoft.com/office/drawing/2014/chartex" xmlns:cx1="http://schemas.microsoft.com/office/drawing/2015/9/8/chartex" xmlns:cx2="http://schemas.microsoft.com/office/drawing/2015/10/21/chartex" xmlns:cx3="http://schemas.microsoft.com/office/drawing/2016/5/9/chartex" xmlns:cx4="http://schemas.microsoft.com/office/drawing/2016/5/10/chartex" xmlns:cx5="http://schemas.microsoft.com/office/drawing/2016/5/11/chartex" xmlns:cx6="http://schemas.microsoft.com/office/drawing/2016/5/12/chartex" xmlns:cx7="http://schemas.microsoft.com/office/drawing/2016/5/13/chartex" xmlns:cx8="http://schemas.microsoft.com/office/drawing/2016/5/14/chartex" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:aink="http://schemas.microsoft.com/office/drawing/2016/ink" xmlns:am3d="http://schemas.microsoft.com/office/drawing/2017/model3d" xmlns:o="urn:schemas-microsoft-com:office:office" xmlns:r="http://schemas.openxmlformats.org/officeDocument/2006/relationships" xmlns:m="http://schemas.openxmlformats.org/officeDocument/2006/math" xmlns:v="urn:schemas-microsoft-com:vml" xmlns:wp14="http://schemas.microsoft.com/office/word/2010/wordprocessingDrawing" xmlns:wp="http://schemas.openxmlformats.org/drawingml/2006/wordprocessingDrawing" xmlns:w10="urn:schemas-microsoft-com:office:word" xmlns:w="http://schemas.openxmlformats.org/wordprocessingml/2006/main" xmlns:w14="http://schemas.microsoft.com/office/word/2010/wordml" xmlns:w15="http://schemas.microsoft.com/office/word/2012/wordml" xmlns:w16cex="http://schemas.microsoft.com/office/word/2018/wordml/cex" xmlns:w16cid="http://schemas.microsoft.com/office/word/2016/wordml/cid" xmlns:w16="http://schemas.microsoft.com/office/word/2018/wordml" xmlns:w16sdtdh="http://schemas.microsoft.com/office/word/2020/wordml/sdtdatahash" xmlns:w16se="http://schemas.microsoft.com/office/word/2015/wordml/symex" xmlns:wpg="http://schemas.microsoft.com/office/word/2010/wordprocessingGroup" xmlns:wpi="http://schemas.microsoft.com/office/word/2010/wordprocessingInk" xmlns:wne="http://schemas.microsoft.com/office/word/2006/wordml" xmlns:wps="http://schemas.microsoft.com/office/word/2010/wordprocessingShape" mc:Ignorable="w14 w15 w16se w16cid w16 w16cex w16sdtdh wp14"><w:body><w:p w14:paraId="4648FD69" w14:textId="72C904CE" w:rsidR="00512C39" w:rsidRPr="00512C39" w:rsidRDefault="00512C39" w:rsidP="00512C39"><w:pPr><w:spacing w:before="100" w:beforeAutospacing="1" w:after="100" w:afterAutospacing="1" w:line="240" w:lineRule="auto"/><w:outlineLvl w:val="1"/><w:rPr><w:rFonts w:ascii="Times New Roman" w:eastAsia="Times New Roman" w:hAnsi="Times New Roman"/><w:b/><w:bCs/><w:color w:val="auto"/><w:sz w:val="36"/><w:szCs w:val="36"/><w:u w:val="none"/><w:lang w:val="pl-PL" w:eastAsia="de-DE"/></w:rPr></w:pPr><w:r w:rsidRPr="00512C39"><w:rPr><w:rFonts w:ascii="Times New Roman" w:eastAsia="Times New Roman" w:hAnsi="Times New Roman"/><w:b/><w:bCs/><w:color w:val="auto"/><w:sz w:val="36"/><w:szCs w:val="36"/><w:u w:val="none"/><w:lang w:val="pl-PL" w:eastAsia="de-DE"/></w:rPr><w:t xml:space="preserve">Poznajmy się bliżej </w:t></w:r></w:p><w:p w14:paraId="792E72EB" w14:textId="1038F653" w:rsidR="00512C39" w:rsidRPr="00512C39" w:rsidRDefault="00512C39" w:rsidP="00512C39"><w:pPr><w:spacing w:before="100" w:beforeAutospacing="1" w:after="100" w:afterAutospacing="1" w:line="240" w:lineRule="auto"/><w:rPr><w:rFonts w:ascii="Times New Roman" w:eastAsia="Times New Roman" w:hAnsi="Times New Roman"/><w:color w:val="auto"/><w:sz w:val="24"/><w:szCs w:val="24"/><w:u w:val="none"/><w:lang w:val="pl-PL" w:eastAsia="de-DE"/></w:rPr></w:pPr><w:r w:rsidRPr="00512C39"><w:rPr><w:rFonts w:ascii="Times New Roman" w:eastAsia="Times New Roman" w:hAnsi="Times New Roman"/><w:color w:val="auto"/><w:sz w:val="24"/><w:szCs w:val="24"/><w:u w:val="none"/><w:lang w:val="pl-PL" w:eastAsia="de-DE"/></w:rPr><w:t xml:space="preserve">Cześć! Skoro tu jesteś, to znaczy, że nasza wspólna podróż właśnie się rozpoczyna. Nazywam się </w:t></w:r><w:r w:rsidR="009A3DAD"><w:rPr><w:rFonts w:ascii="Times New Roman" w:eastAsia="Times New Roman" w:hAnsi="Times New Roman"/><w:color w:val="auto"/><w:sz w:val="24"/><w:szCs w:val="24"/><w:u w:val="none"/><w:lang w:val="pl-PL" w:eastAsia="de-DE"/></w:rPr><w:t xml:space="preserve">Renata Mickiewicz-Krucinski, jestem </w:t></w:r><w:r w:rsidRPr="00512C39"><w:rPr><w:rFonts w:ascii="Times New Roman" w:eastAsia="Times New Roman" w:hAnsi="Times New Roman"/><w:color w:val="auto"/><w:sz w:val="24"/><w:szCs w:val="24"/><w:u w:val="none"/><w:lang w:val="pl-PL" w:eastAsia="de-DE"/></w:rPr><w:t xml:space="preserve">twórczynią </w:t></w:r><w:r w:rsidRPr="009A3DAD"><w:rPr><w:rFonts w:ascii="Times New Roman" w:eastAsia="Times New Roman" w:hAnsi="Times New Roman"/><w:color w:val="auto"/><w:sz w:val="24"/><w:szCs w:val="24"/><w:u w:val="none"/><w:lang w:val="pl-PL" w:eastAsia="de-DE"/></w:rPr><w:t>Numeronarracji</w:t></w:r><w:r w:rsidRPr="00512C39"><w:rPr><w:rFonts w:ascii="Times New Roman" w:eastAsia="Times New Roman" w:hAnsi="Times New Roman"/><w:color w:val="auto"/><w:sz w:val="24"/><w:szCs w:val="24"/><w:u w:val="none"/><w:lang w:val="pl-PL" w:eastAsia="de-DE"/></w:rPr><w:t xml:space="preserve">, ale przede wszystkim jestem kobietą, która przez lata uczyła się, jak przestać ze sobą walczyć, a zacząć siebie słuchać. </w:t></w:r></w:p><w:p w14:paraId="05FB900B" w14:textId="77777777" w:rsidR="00512C39" w:rsidRPr="00512C39" w:rsidRDefault="00512C39" w:rsidP="00512C39"><w:pPr><w:spacing w:before="100" w:beforeAutospacing="1" w:after="100" w:afterAutospacing="1" w:line="240" w:lineRule="auto"/><w:rPr><w:rFonts w:ascii="Times New Roman" w:eastAsia="Times New Roman" w:hAnsi="Times New Roman"/><w:color w:val="auto"/><w:sz w:val="24"/><w:szCs w:val="24"/><w:u w:val="none"/><w:lang w:val="pl-PL" w:eastAsia="de-DE"/></w:rPr></w:pPr><w:r w:rsidRPr="00512C39"><w:rPr><w:rFonts w:ascii="Times New Roman" w:eastAsia="Times New Roman" w:hAnsi="Times New Roman"/><w:color w:val="auto"/><w:sz w:val="24"/><w:szCs w:val="24"/><w:u w:val="none"/><w:lang w:val="pl-PL" w:eastAsia="de-DE"/></w:rPr><w:t xml:space="preserve">Moja droga do miejsca, w którym jestem dzisiaj, to nie był nagły zwrot akcji, ale naturalne, piękne dojrzewanie. Od kiedy pamiętam, fascynowały mnie trzy rzeczy: liczby, sztuka oraz ludzie. To połączenie towarzyszyło mi na każdym etapie życia, choć z czasem zaczęło przybierać zupełnie nowe, głębsze barwy. </w:t></w:r></w:p><w:p w14:paraId="1ED1B46A" w14:textId="77777777" w:rsidR="00512C39" w:rsidRPr="00512C39" w:rsidRDefault="00512C39" w:rsidP="00512C39"><w:pPr><w:spacing w:before="100" w:beforeAutospacing="1" w:after="100" w:afterAutospacing="1" w:line="240" w:lineRule="auto"/><w:outlineLvl w:val="2"/><w:rPr><w:rFonts w:ascii="Times New Roman" w:eastAsia="Times New Roman" w:hAnsi="Times New Roman"/><w:b/><w:bCs/><w:color w:val="auto"/><w:sz w:val="27"/><w:szCs w:val="27"/><w:u w:val="none"/><w:lang w:val="pl-PL" w:eastAsia="de-DE"/></w:rPr></w:pPr><w:r w:rsidRPr="00512C39"><w:rPr><w:rFonts w:ascii="Times New Roman" w:eastAsia="Times New Roman" w:hAnsi="Times New Roman"/><w:b/><w:bCs/><w:color w:val="auto"/><w:sz w:val="27"/><w:szCs w:val="27"/><w:u w:val="none"/><w:lang w:val="pl-PL" w:eastAsia="de-DE"/></w:rPr><w:t>Od precyzji liczb do głębi ludzkiej natury</w:t></w:r></w:p><w:p w14:paraId="6E0305BF" w14:textId="77777777" w:rsidR="00512C39" w:rsidRPr="00512C39" w:rsidRDefault="00512C39" w:rsidP="00512C39"><w:pPr><w:spacing w:before="100" w:beforeAutospacing="1" w:after="100" w:afterAutospacing="1" w:line="240" w:lineRule="auto"/><w:rPr><w:rFonts w:ascii="Times New Roman" w:eastAsia="Times New Roman" w:hAnsi="Times New Roman"/><w:color w:val="auto"/><w:sz w:val="24"/><w:szCs w:val="24"/><w:u w:val="none"/><w:lang w:val="pl-PL" w:eastAsia="de-DE"/></w:rPr></w:pPr><w:r w:rsidRPr="00512C39"><w:rPr><w:rFonts w:ascii="Times New Roman" w:eastAsia="Times New Roman" w:hAnsi="Times New Roman"/><w:color w:val="auto"/><w:sz w:val="24"/><w:szCs w:val="24"/><w:u w:val="none"/><w:lang w:val="pl-PL" w:eastAsia="de-DE"/></w:rPr><w:t xml:space="preserve">Może Cię to zaskoczyć, ale moja zawodowa ścieżka zaczęła się... w świecie finansów. Już w szkole z pasją uczestniczyłam w kółku matematycznym, uwielbiając moment, gdy chaos danych układał się w jasną, logiczną strukturę. Ta miłość do porządku poprowadziła mnie przez naukę rachunkowości prosto do świata podatków i księgowości. Przez lata analizowałam cyfry w poszukiwaniu błędów i faktów. </w:t></w:r></w:p><w:p w14:paraId="050055EB" w14:textId="064AE713" w:rsidR="00512C39" w:rsidRPr="00512C39" w:rsidRDefault="00512C39" w:rsidP="00512C39"><w:pPr><w:spacing w:before="100" w:beforeAutospacing="1" w:after="100" w:afterAutospacing="1" w:line="240" w:lineRule="auto"/><w:rPr><w:rFonts w:ascii="Times New Roman" w:eastAsia="Times New Roman" w:hAnsi="Times New Roman"/><w:color w:val="auto"/><w:sz w:val="24"/><w:szCs w:val="24"/><w:u w:val="none"/><w:lang w:val="pl-PL" w:eastAsia="de-DE"/></w:rPr></w:pPr><w:r w:rsidRPr="00512C39"><w:rPr><w:rFonts w:ascii="Times New Roman" w:eastAsia="Times New Roman" w:hAnsi="Times New Roman"/><w:color w:val="auto"/><w:sz w:val="24"/><w:szCs w:val="24"/><w:u w:val="none"/><w:lang w:val="pl-PL" w:eastAsia="de-DE"/></w:rPr><w:t xml:space="preserve">Dziś te same liczby służą mi do czegoś znacznie głębszego – do czytania ludzkiej natury, emocji i ukrytego potencjału. Zrozumiałam, że liczby to nie tylko narzędzie do liczenia materii, ale potężny kod, który pozwala zrozumieć mechanizmy naszych zachowań, blokad </w:t></w:r><w:r w:rsidR="009A3DAD"><w:rPr><w:rFonts w:ascii="Times New Roman" w:eastAsia="Times New Roman" w:hAnsi="Times New Roman"/><w:color w:val="auto"/><w:sz w:val="24"/><w:szCs w:val="24"/><w:u w:val="none"/><w:lang w:val="pl-PL" w:eastAsia="de-DE"/></w:rPr><w:t>w</w:t></w:r><w:r w:rsidRPr="00512C39"><w:rPr><w:rFonts w:ascii="Times New Roman" w:eastAsia="Times New Roman" w:hAnsi="Times New Roman"/><w:color w:val="auto"/><w:sz w:val="24"/><w:szCs w:val="24"/><w:u w:val="none"/><w:lang w:val="pl-PL" w:eastAsia="de-DE"/></w:rPr><w:t xml:space="preserve"> relacji. Jako dojrzała kobieta doskonale wiem, jak to jest czuć się samotną we własnym życiu, mimo posiadania rodziny, pracy i codziennych obowiązków. Wiem, jak wyczerpująca potrafi być wewnętrzna walka z samą sobą i próba sprostania oczekiwaniom świata, zapominając o własnych potrzebach. </w:t></w:r></w:p><w:p w14:paraId="78ECD0A4" w14:textId="182219F3" w:rsidR="00512C39" w:rsidRPr="00512C39" w:rsidRDefault="00512C39" w:rsidP="00512C39"><w:pPr><w:spacing w:before="100" w:beforeAutospacing="1" w:after="100" w:afterAutospacing="1" w:line="240" w:lineRule="auto"/><w:rPr><w:rFonts w:ascii="Times New Roman" w:eastAsia="Times New Roman" w:hAnsi="Times New Roman"/><w:color w:val="auto"/><w:sz w:val="24"/><w:szCs w:val="24"/><w:u w:val="none"/><w:lang w:val="pl-PL" w:eastAsia="de-DE"/></w:rPr></w:pPr><w:r w:rsidRPr="00512C39"><w:rPr><w:rFonts w:ascii="Times New Roman" w:eastAsia="Times New Roman" w:hAnsi="Times New Roman"/><w:color w:val="auto"/><w:sz w:val="24"/><w:szCs w:val="24"/><w:u w:val="none"/><w:lang w:val="pl-PL" w:eastAsia="de-DE"/></w:rPr><w:t xml:space="preserve">Moja własna podróż przez mapę numerologiczną przyniosła </w:t></w:r><w:r w:rsidR="009A3DAD"><w:rPr><w:rFonts w:ascii="Times New Roman" w:eastAsia="Times New Roman" w:hAnsi="Times New Roman"/><w:color w:val="auto"/><w:sz w:val="24"/><w:szCs w:val="24"/><w:u w:val="none"/><w:lang w:val="pl-PL" w:eastAsia="de-DE"/></w:rPr><w:t xml:space="preserve">mi </w:t></w:r><w:r w:rsidRPr="00512C39"><w:rPr><w:rFonts w:ascii="Times New Roman" w:eastAsia="Times New Roman" w:hAnsi="Times New Roman"/><w:color w:val="auto"/><w:sz w:val="24"/><w:szCs w:val="24"/><w:u w:val="none"/><w:lang w:val="pl-PL" w:eastAsia="de-DE"/></w:rPr><w:t>przełom – pozwolił</w:t></w:r><w:r w:rsidR="009A3DAD"><w:rPr><w:rFonts w:ascii="Times New Roman" w:eastAsia="Times New Roman" w:hAnsi="Times New Roman"/><w:color w:val="auto"/><w:sz w:val="24"/><w:szCs w:val="24"/><w:u w:val="none"/><w:lang w:val="pl-PL" w:eastAsia="de-DE"/></w:rPr><w:t>a</w:t></w:r><w:r w:rsidRPr="00512C39"><w:rPr><w:rFonts w:ascii="Times New Roman" w:eastAsia="Times New Roman" w:hAnsi="Times New Roman"/><w:color w:val="auto"/><w:sz w:val="24"/><w:szCs w:val="24"/><w:u w:val="none"/><w:lang w:val="pl-PL" w:eastAsia="de-DE"/></w:rPr><w:t xml:space="preserve"> przestać ze sobą walczyć, zrozumieć swoje emocje, nazwać skrywane talenty i spojrzeć na siebie z głęboką czułością. To właśnie to doświadczenie stało się moją misją. </w:t></w:r></w:p><w:p w14:paraId="300D0D3A" w14:textId="77777777" w:rsidR="00512C39" w:rsidRPr="00512C39" w:rsidRDefault="00512C39" w:rsidP="00512C39"><w:pPr><w:spacing w:before="100" w:beforeAutospacing="1" w:after="100" w:afterAutospacing="1" w:line="240" w:lineRule="auto"/><w:outlineLvl w:val="2"/><w:rPr><w:rFonts w:ascii="Times New Roman" w:eastAsia="Times New Roman" w:hAnsi="Times New Roman"/><w:b/><w:bCs/><w:color w:val="auto"/><w:sz w:val="27"/><w:szCs w:val="27"/><w:u w:val="none"/><w:lang w:val="pl-PL" w:eastAsia="de-DE"/></w:rPr></w:pPr><w:r w:rsidRPr="00512C39"><w:rPr><w:rFonts w:ascii="Times New Roman" w:eastAsia="Times New Roman" w:hAnsi="Times New Roman"/><w:b/><w:bCs/><w:color w:val="auto"/><w:sz w:val="27"/><w:szCs w:val="27"/><w:u w:val="none"/><w:lang w:val="pl-PL" w:eastAsia="de-DE"/></w:rPr><w:t>Dusza artysty, kreatywność i moc opowieści</w:t></w:r></w:p><w:p w14:paraId="7FC14867" w14:textId="77777777" w:rsidR="00512C39" w:rsidRPr="00512C39" w:rsidRDefault="00512C39" w:rsidP="00512C39"><w:pPr><w:spacing w:before="100" w:beforeAutospacing="1" w:after="100" w:afterAutospacing="1" w:line="240" w:lineRule="auto"/><w:rPr><w:rFonts w:ascii="Times New Roman" w:eastAsia="Times New Roman" w:hAnsi="Times New Roman"/><w:color w:val="auto"/><w:sz w:val="24"/><w:szCs w:val="24"/><w:u w:val="none"/><w:lang w:val="pl-PL" w:eastAsia="de-DE"/></w:rPr></w:pPr><w:r w:rsidRPr="00512C39"><w:rPr><w:rFonts w:ascii="Times New Roman" w:eastAsia="Times New Roman" w:hAnsi="Times New Roman"/><w:color w:val="auto"/><w:sz w:val="24"/><w:szCs w:val="24"/><w:u w:val="none"/><w:lang w:val="pl-PL" w:eastAsia="de-DE"/></w:rPr><w:t xml:space="preserve">Obok analitycznego umysłu dawnej księgowej, bije we mnie żywe serce artystki i kreatywnej duszy. Moja fascynacja sztuką i ludzkim wnętrzem sprawiła, że zaczęłam przelewać emocje na papier. Tworzę z intencją, by słowo niosło ukojenie, dawało odwagę i pomagało rozkodować to, co w nas zablokowane. </w:t></w:r></w:p><w:p w14:paraId="35038B8F" w14:textId="77777777" w:rsidR="00512C39" w:rsidRPr="00512C39" w:rsidRDefault="00512C39" w:rsidP="00512C39"><w:pPr><w:numPr><w:ilvl w:val="0"/><w:numId w:val="1"/></w:numPr><w:spacing w:before="100" w:beforeAutospacing="1" w:after="100" w:afterAutospacing="1" w:line="240" w:lineRule="auto"/><w:rPr><w:rFonts w:ascii="Times New Roman" w:eastAsia="Times New Roman" w:hAnsi="Times New Roman"/><w:color w:val="auto"/><w:sz w:val="24"/><w:szCs w:val="24"/><w:u w:val="none"/><w:lang w:val="pl-PL" w:eastAsia="de-DE"/></w:rPr></w:pPr><w:r w:rsidRPr="00512C39"><w:rPr><w:rFonts w:ascii="Times New Roman" w:eastAsia="Times New Roman" w:hAnsi="Times New Roman"/><w:b/><w:bCs/><w:color w:val="auto"/><w:sz w:val="24"/><w:szCs w:val="24"/><w:u w:val="none"/><w:lang w:val="pl-PL" w:eastAsia="de-DE"/></w:rPr><w:t>Bajki dla dzieci o emocjach:</w:t></w:r><w:r w:rsidRPr="00512C39"><w:rPr><w:rFonts w:ascii="Times New Roman" w:eastAsia="Times New Roman" w:hAnsi="Times New Roman"/><w:color w:val="auto"/><w:sz w:val="24"/><w:szCs w:val="24"/><w:u w:val="none"/><w:lang w:val="pl-PL" w:eastAsia="de-DE"/></w:rPr><w:t xml:space="preserve"> Piszę opowiadania dla najmłodszych, aby od małego uczyć je, że nie są same ze swoimi uczuciami. Chcę dawać dzieciom odwagę do mówienia o tym, co przeżywają, co je smuci lub złości.</w:t></w:r></w:p><w:p w14:paraId="640DB567" w14:textId="106544CC" w:rsidR="00512C39" w:rsidRPr="00512C39" w:rsidRDefault="00512C39" w:rsidP="00512C39"><w:pPr><w:numPr><w:ilvl w:val="0"/><w:numId w:val="1"/></w:numPr><w:spacing w:before="100" w:beforeAutospacing="1" w:after="100" w:afterAutospacing="1" w:line="240" w:lineRule="auto"/><w:rPr><w:rFonts w:ascii="Times New Roman" w:eastAsia="Times New Roman" w:hAnsi="Times New Roman"/><w:color w:val="auto"/><w:sz w:val="24"/><w:szCs w:val="24"/><w:u w:val="none"/><w:lang w:val="pl-PL" w:eastAsia="de-DE"/></w:rPr></w:pPr><w:r w:rsidRPr="00512C39"><w:rPr><w:rFonts w:ascii="Times New Roman" w:eastAsia="Times New Roman" w:hAnsi="Times New Roman"/><w:b/><w:bCs/><w:color w:val="auto"/><w:sz w:val="24"/><w:szCs w:val="24"/><w:u w:val="none"/><w:lang w:val="pl-PL" w:eastAsia="de-DE"/></w:rPr><w:t>Spersonalizowane opowiadania dla dorosłych:</w:t></w:r><w:r w:rsidRPr="00512C39"><w:rPr><w:rFonts w:ascii="Times New Roman" w:eastAsia="Times New Roman" w:hAnsi="Times New Roman"/><w:color w:val="auto"/><w:sz w:val="24"/><w:szCs w:val="24"/><w:u w:val="none"/><w:lang w:val="pl-PL" w:eastAsia="de-DE"/></w:rPr><w:t xml:space="preserve"> Na bazie daty urodzenia tworzę osobiste narracje. To wyjątkowe, literackie zwierciadła, które pomagają dorosłym uświadomić sobie talenty i potencjały, o których istnieniu często nie mieli pojęcia, bo zostały przykryte przez stare schematy i przekonania.</w:t></w:r></w:p><w:p w14:paraId="4584D904" w14:textId="77777777" w:rsidR="009A3DAD" w:rsidRDefault="009A3DAD" w:rsidP="00512C39"><w:pPr><w:spacing w:before="100" w:beforeAutospacing="1" w:after="100" w:afterAutospacing="1" w:line="240" w:lineRule="auto"/><w:outlineLvl w:val="2"/><w:rPr><w:rFonts w:ascii="Times New Roman" w:eastAsia="Times New Roman" w:hAnsi="Times New Roman"/><w:b/><w:bCs/><w:color w:val="auto"/><w:sz w:val="27"/><w:szCs w:val="27"/><w:u w:val="none"/><w:lang w:val="pl-PL" w:eastAsia="de-DE"/></w:rPr></w:pPr></w:p><w:p w14:paraId="7FD5084D" w14:textId="77777777" w:rsidR="009A3DAD" w:rsidRDefault="009A3DAD" w:rsidP="00512C39"><w:pPr><w:spacing w:before="100" w:beforeAutospacing="1" w:after="100" w:afterAutospacing="1" w:line="240" w:lineRule="auto"/><w:outlineLvl w:val="2"/><w:rPr><w:rFonts w:ascii="Times New Roman" w:eastAsia="Times New Roman" w:hAnsi="Times New Roman"/><w:b/><w:bCs/><w:color w:val="auto"/><w:sz w:val="27"/><w:szCs w:val="27"/><w:u w:val="none"/><w:lang w:val="pl-PL" w:eastAsia="de-DE"/></w:rPr></w:pPr></w:p><w:p w14:paraId="7CF5230E" w14:textId="148650C3" w:rsidR="00512C39" w:rsidRPr="00512C39" w:rsidRDefault="00512C39" w:rsidP="00512C39"><w:pPr><w:spacing w:before="100" w:beforeAutospacing="1" w:after="100" w:afterAutospacing="1" w:line="240" w:lineRule="auto"/><w:outlineLvl w:val="2"/><w:rPr><w:rFonts w:ascii="Times New Roman" w:eastAsia="Times New Roman" w:hAnsi="Times New Roman"/><w:b/><w:bCs/><w:color w:val="auto"/><w:sz w:val="27"/><w:szCs w:val="27"/><w:u w:val="none"/><w:lang w:val="pl-PL" w:eastAsia="de-DE"/></w:rPr></w:pPr><w:r w:rsidRPr="00512C39"><w:rPr><w:rFonts w:ascii="Times New Roman" w:eastAsia="Times New Roman" w:hAnsi="Times New Roman"/><w:b/><w:bCs/><w:color w:val="auto"/><w:sz w:val="27"/><w:szCs w:val="27"/><w:u w:val="none"/><w:lang w:val="pl-PL" w:eastAsia="de-DE"/></w:rPr><w:lastRenderedPageBreak/><w:t>Z uśmiechem przez życie (nawet gdy nie jest do śmiechu)</w:t></w:r></w:p><w:p w14:paraId="634ECCD7" w14:textId="77777777" w:rsidR="00512C39" w:rsidRPr="00512C39" w:rsidRDefault="00512C39" w:rsidP="00512C39"><w:pPr><w:spacing w:before="100" w:beforeAutospacing="1" w:after="100" w:afterAutospacing="1" w:line="240" w:lineRule="auto"/><w:rPr><w:rFonts w:ascii="Times New Roman" w:eastAsia="Times New Roman" w:hAnsi="Times New Roman"/><w:color w:val="auto"/><w:sz w:val="24"/><w:szCs w:val="24"/><w:u w:val="none"/><w:lang w:val="pl-PL" w:eastAsia="de-DE"/></w:rPr></w:pPr><w:r w:rsidRPr="00512C39"><w:rPr><w:rFonts w:ascii="Times New Roman" w:eastAsia="Times New Roman" w:hAnsi="Times New Roman"/><w:color w:val="auto"/><w:sz w:val="24"/><w:szCs w:val="24"/><w:u w:val="none"/><w:lang w:val="pl-PL" w:eastAsia="de-DE"/></w:rPr><w:t>Wierzę, że kluczem do dobrego życia jest patrzenie na świat pozytywnie i z uśmiechem. Oczywiście doskonale wiem, że życie pisze różne scenariusze i absolutnie nie zawsze jest nam do śmiechu. Doświadczamy trudów, smutku i zwątpienia. Jednak nawet w najciemniejszych momentach, odrobina ciepłego dystansu, pogody ducha i uśmiechu potrafi zadziałać jak plaster na poranioną duszę i pomóc nam przetrwać burzę. W mojej przestrzeni jest miejsce na każdą Twoją emocję – na łzy, refleksję, ale też na oczyszczający, szczery śmiech.</w:t></w:r></w:p><w:p w14:paraId="61153E94" w14:textId="77777777" w:rsidR="00512C39" w:rsidRPr="00512C39" w:rsidRDefault="00512C39" w:rsidP="00512C39"><w:pPr><w:spacing w:before="100" w:beforeAutospacing="1" w:after="100" w:afterAutospacing="1" w:line="240" w:lineRule="auto"/><w:outlineLvl w:val="2"/><w:rPr><w:rFonts w:ascii="Times New Roman" w:eastAsia="Times New Roman" w:hAnsi="Times New Roman"/><w:b/><w:bCs/><w:color w:val="auto"/><w:sz w:val="27"/><w:szCs w:val="27"/><w:u w:val="none"/><w:lang w:val="pl-PL" w:eastAsia="de-DE"/></w:rPr></w:pPr><w:r w:rsidRPr="00512C39"><w:rPr><w:rFonts w:ascii="Times New Roman" w:eastAsia="Times New Roman" w:hAnsi="Times New Roman"/><w:b/><w:bCs/><w:color w:val="auto"/><w:sz w:val="27"/><w:szCs w:val="27"/><w:u w:val="none"/><w:lang w:val="pl-PL" w:eastAsia="de-DE"/></w:rPr><w:t>Moja misja dla Ciebie</w:t></w:r></w:p><w:p w14:paraId="070E91E1" w14:textId="77777777" w:rsidR="00512C39" w:rsidRPr="00512C39" w:rsidRDefault="00512C39" w:rsidP="00512C39"><w:pPr><w:spacing w:before="100" w:beforeAutospacing="1" w:after="100" w:afterAutospacing="1" w:line="240" w:lineRule="auto"/><w:rPr><w:rFonts w:ascii="Times New Roman" w:eastAsia="Times New Roman" w:hAnsi="Times New Roman"/><w:color w:val="auto"/><w:sz w:val="24"/><w:szCs w:val="24"/><w:u w:val="none"/><w:lang w:val="pl-PL" w:eastAsia="de-DE"/></w:rPr></w:pPr><w:r w:rsidRPr="00512C39"><w:rPr><w:rFonts w:ascii="Times New Roman" w:eastAsia="Times New Roman" w:hAnsi="Times New Roman"/><w:color w:val="auto"/><w:sz w:val="24"/><w:szCs w:val="24"/><w:u w:val="none"/><w:lang w:val="pl-PL" w:eastAsia="de-DE"/></w:rPr><w:t xml:space="preserve">Dziś łączę analityczną precyzję z intuicją i empatią, pomagając kobietom takim jak Ty odkryć ich własną, unikalną mapę życia. </w:t></w:r></w:p><w:p w14:paraId="54FF1D9C" w14:textId="357AE4A0" w:rsidR="00512C39" w:rsidRPr="00512C39" w:rsidRDefault="00512C39" w:rsidP="00512C39"><w:pPr><w:spacing w:before="100" w:beforeAutospacing="1" w:after="100" w:afterAutospacing="1" w:line="240" w:lineRule="auto"/><w:rPr><w:rFonts w:ascii="Times New Roman" w:eastAsia="Times New Roman" w:hAnsi="Times New Roman"/><w:color w:val="auto"/><w:sz w:val="24"/><w:szCs w:val="24"/><w:u w:val="none"/><w:lang w:val="pl-PL" w:eastAsia="de-DE"/></w:rPr></w:pPr><w:r w:rsidRPr="00512C39"><w:rPr><w:rFonts w:ascii="Times New Roman" w:eastAsia="Times New Roman" w:hAnsi="Times New Roman"/><w:color w:val="auto"/><w:sz w:val="24"/><w:szCs w:val="24"/><w:u w:val="none"/><w:lang w:val="pl-PL" w:eastAsia="de-DE"/></w:rPr><w:t>Wierzę głęboko, że kiedy zaczynamy lepiej rozumieć mechanizmy rządzące nami oraz ludźmi w naszym otoczeniu, nasze relacje stają się znacznie prostsze. Przestajemy zgadywać intencje innych, a zaczynamy o</w:t></w:r><w:r w:rsidR="009A3DAD"><w:rPr><w:rFonts w:ascii="Times New Roman" w:eastAsia="Times New Roman" w:hAnsi="Times New Roman"/><w:color w:val="auto"/><w:sz w:val="24"/><w:szCs w:val="24"/><w:u w:val="none"/><w:lang w:val="pl-PL" w:eastAsia="de-DE"/></w:rPr><w:t>twierać</w:t></w:r><w:r w:rsidRPr="00512C39"><w:rPr><w:rFonts w:ascii="Times New Roman" w:eastAsia="Times New Roman" w:hAnsi="Times New Roman"/><w:color w:val="auto"/><w:sz w:val="24"/><w:szCs w:val="24"/><w:u w:val="none"/><w:lang w:val="pl-PL" w:eastAsia="de-DE"/></w:rPr><w:t xml:space="preserve"> się na wzajemn</w:t></w:r><w:r 