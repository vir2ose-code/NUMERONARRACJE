:eastAsia="de-DE"/></w:rPr><w:t xml:space="preserve"> Zobacz, jaka wibracja (od 1 do 9) dominuje dzisiejszego dnia i jaką jakość ze sobą niesie.</w:t></w:r></w:p><w:p w14:paraId="0A78C209" w14:textId="77777777" w:rsidR="00680DE3" w:rsidRPr="00680DE3" w:rsidRDefault="00680DE3" w:rsidP="00680DE3"><w:pPr><w:numPr><w:ilvl w:val="0"/><w:numId w:val="1"/></w:numPr><w:spacing w:before="100" w:beforeAutospacing="1" w:after="100" w:afterAutospacing="1" w:line="240" w:lineRule="auto"/><w:rPr><w:rFonts w:eastAsia="Times New Roman" w:cs="Arial"/><w:color w:val="auto"/><w:szCs w:val="22"/><w:u w:val="none"/><w:lang w:val="pl-PL" w:eastAsia="de-DE"/></w:rPr></w:pPr><w:r w:rsidRPr="00680DE3"><w:rPr><w:rFonts w:eastAsia="Times New Roman" w:cs="Arial"/><w:b/><w:bCs/><w:color w:val="auto"/><w:szCs w:val="22"/><w:u w:val="none"/><w:lang w:val="pl-PL" w:eastAsia="de-DE"/></w:rPr><w:t>Przeczytaj krótką narrację:</w:t></w:r><w:r w:rsidRPr="00680DE3"><w:rPr><w:rFonts w:eastAsia="Times New Roman" w:cs="Arial"/><w:color w:val="auto"/><w:szCs w:val="22"/><w:u w:val="none"/><w:lang w:val="pl-PL" w:eastAsia="de-DE"/></w:rPr><w:t xml:space="preserve"> Pozwól słowom z opisu rezonować w Tobie i zobacz, jak rezonują z Twoim samopoczuciem.</w:t></w:r></w:p><w:p w14:paraId="55B8974E" w14:textId="77777777" w:rsidR="00680DE3" w:rsidRPr="00680DE3" w:rsidRDefault="00680DE3" w:rsidP="00680DE3"><w:pPr><w:numPr><w:ilvl w:val="0"/><w:numId w:val="1"/></w:numPr><w:spacing w:before="100" w:beforeAutospacing="1" w:after="100" w:afterAutospacing="1" w:line="240" w:lineRule="auto"/><w:rPr><w:rFonts w:eastAsia="Times New Roman" w:cs="Arial"/><w:color w:val="auto"/><w:szCs w:val="22"/><w:u w:val="none"/><w:lang w:val="pl-PL" w:eastAsia="de-DE"/></w:rPr></w:pPr><w:r w:rsidRPr="00680DE3"><w:rPr><w:rFonts w:eastAsia="Times New Roman" w:cs="Arial"/><w:b/><w:bCs/><w:color w:val="auto"/><w:szCs w:val="22"/><w:u w:val="none"/><w:lang w:val="pl-PL" w:eastAsia="de-DE"/></w:rPr><w:t>Spójrz na rekomendacje:</w:t></w:r><w:r w:rsidRPr="00680DE3"><w:rPr><w:rFonts w:eastAsia="Times New Roman" w:cs="Arial"/><w:color w:val="auto"/><w:szCs w:val="22"/><w:u w:val="none"/><w:lang w:val="pl-PL" w:eastAsia="de-DE"/></w:rPr><w:t xml:space="preserve"> Zobacz, jakie działania i postawy będą dziś dla Ciebie naturalnym wsparciem, a jakich sytuacji lepiej unikać, aby zachować wewnętrzną harmonię.</w:t></w:r></w:p><w:p w14:paraId="2591627B" w14:textId="42260FCC" w:rsidR="00680DE3" w:rsidRPr="00680DE3" w:rsidRDefault="00680DE3" w:rsidP="00680DE3"><w:pPr><w:spacing w:before="100" w:beforeAutospacing="1" w:after="100" w:afterAutospacing="1" w:line="240" w:lineRule="auto"/><w:outlineLvl w:val="3"/><w:rPr><w:rFonts w:eastAsia="Times New Roman" w:cs="Arial"/><w:b/><w:bCs/><w:color w:val="auto"/><w:szCs w:val="22"/><w:lang w:val="pl-PL" w:eastAsia="de-DE"/></w:rPr></w:pPr><w:r w:rsidRPr="00680DE3"><w:rPr><w:rFonts w:eastAsia="Times New Roman" w:cs="Arial"/><w:b/><w:bCs/><w:color w:val="auto"/><w:szCs w:val="22"/><w:lang w:val="pl-PL" w:eastAsia="de-DE"/></w:rPr><w:t>W ciągu dnia: Chwila oddechu i... uśmiechu!</w:t></w:r></w:p><w:p w14:paraId="557BC5AD" w14:textId="77777777" w:rsidR="00680DE3" w:rsidRPr="00680DE3" w:rsidRDefault="00680DE3" w:rsidP="00680DE3"><w:pPr><w:spacing w:before="100" w:beforeAutospacing="1" w:after="100" w:afterAutospacing="1" w:line="240" w:lineRule="auto"/><w:rPr><w:rFonts w:eastAsia="Times New Roman" w:cs="Arial"/><w:color w:val="auto"/><w:szCs w:val="22"/><w:u w:val="none"/><w:lang w:val="pl-PL" w:eastAsia="de-DE"/></w:rPr></w:pPr><w:r w:rsidRPr="00680DE3"><w:rPr><w:rFonts w:eastAsia="Times New Roman" w:cs="Arial"/><w:color w:val="auto"/><w:szCs w:val="22"/><w:u w:val="none"/><w:lang w:val="pl-PL" w:eastAsia="de-DE"/></w:rPr><w:t>Rozwój osobisty i praca z emocjami wcale nie muszą być śmiertelnie poważne. Czasem najlepszym lekarstwem na zablokowane w ciele napięcie jest po prostu szczery, głęboki uśmiech.</w:t></w:r></w:p><w:p w14:paraId="085B5225" w14:textId="77777777" w:rsidR="00680DE3" w:rsidRPr="00680DE3" w:rsidRDefault="00680DE3" w:rsidP="00680DE3"><w:pPr><w:numPr><w:ilvl w:val="0"/><w:numId w:val="2"/></w:numPr><w:spacing w:before="100" w:beforeAutospacing="1" w:after="100" w:afterAutospacing="1" w:line="240" w:lineRule="auto"/><w:rPr><w:rFonts w:eastAsia="Times New Roman" w:cs="Arial"/><w:color w:val="auto"/><w:szCs w:val="22"/><w:u w:val="none"/><w:lang w:val="pl-PL" w:eastAsia="de-DE"/></w:rPr></w:pPr><w:r w:rsidRPr="00680DE3"><w:rPr><w:rFonts w:eastAsia="Times New Roman" w:cs="Arial"/><w:b/><w:bCs/><w:color w:val="auto"/><w:szCs w:val="22"/><w:u w:val="none"/><w:lang w:val="pl-PL" w:eastAsia="de-DE"/></w:rPr><w:t>Strefa Humoru:</w:t></w:r><w:r w:rsidRPr="00680DE3"><w:rPr><w:rFonts w:eastAsia="Times New Roman" w:cs="Arial"/><w:color w:val="auto"/><w:szCs w:val="22"/><w:u w:val="none"/><w:lang w:val="pl-PL" w:eastAsia="de-DE"/></w:rPr><w:t xml:space="preserve"> Zajrzyj tutaj, kiedy poczujesz, że potrzebujesz oderwać myśli. Przygotowałam dla Ciebie lekkie, trafne i pełne dystansu żarty oraz anegdoty. Pozwól sobie na uśmiech – śmiech to najpiękniejsza forma uwalniania energii i zdejmowania z siebie ciężaru oczekiwań!</w:t></w:r></w:p><w:p w14:paraId="326B162E" w14:textId="4938DCED" w:rsidR="00680DE3" w:rsidRPr="00680DE3" w:rsidRDefault="00680DE3" w:rsidP="00680DE3"><w:pPr><w:spacing w:before="100" w:beforeAutospacing="1" w:after="100" w:afterAutospacing="1" w:line="240" w:lineRule="auto"/><w:outlineLvl w:val="3"/><w:rPr><w:rFonts w:eastAsia="Times New Roman" w:cs="Arial"/><w:b/><w:bCs/><w:color w:val="auto"/><w:szCs w:val="22"/><w:u w:val="none"/><w:lang w:val="pl-PL" w:eastAsia="de-DE"/></w:rPr></w:pPr><w:r w:rsidRPr="00680DE3"><w:rPr><w:rFonts w:eastAsia="Times New Roman" w:cs="Arial"/><w:b/><w:bCs/><w:color w:val="auto"/><w:szCs w:val="22"/><w:u w:val="none"/><w:lang w:val="pl-PL" w:eastAsia="de-DE"/></w:rPr><w:t xml:space="preserve"> Przestrzeń Community: Jesteś wśród swoich</w:t></w:r></w:p><w:p w14:paraId="513EBA27" w14:textId="77777777" w:rsidR="00680DE3" w:rsidRPr="00680DE3" w:rsidRDefault="00680DE3" w:rsidP="00680DE3"><w:pPr><w:spacing w:before="100" w:beforeAutospacing="1" w:after="100" w:afterAutospacing="1" w:line="240" w:lineRule="auto"/><w:rPr><w:rFonts w:eastAsia="Times New Roman" w:cs="Arial"/><w:color w:val="auto"/><w:szCs w:val="22"/><w:u w:val="none"/><w:lang w:val="pl-PL" w:eastAsia="de-DE"/></w:rPr></w:pPr><w:r w:rsidRPr="00680DE3"><w:rPr><w:rFonts w:eastAsia="Times New Roman" w:cs="Arial"/><w:color w:val="auto"/><w:szCs w:val="22"/><w:u w:val="none"/><w:lang w:val="pl-PL" w:eastAsia="de-DE"/></w:rPr><w:t>To jedno z najważniejszych miejsc w naszej aplikacji – serce Numeronarracji. Stworzyłam tę bezpieczną przestrzeń specjalnie dla kobiet, które tak jak Ty chcą zrzucić maski i pogadać o tym, co naprawdę czują.</w:t></w:r></w:p><w:p w14:paraId="6E784308" w14:textId="77777777" w:rsidR="00680DE3" w:rsidRPr="00680DE3" w:rsidRDefault="00680DE3" w:rsidP="00680DE3"><w:pPr><w:numPr><w:ilvl w:val="0"/><w:numId w:val="3"/></w:numPr><w:spacing w:before="100" w:beforeAutospacing="1" w:after="100" w:afterAutospacing="1" w:line="240" w:lineRule="auto"/><w:rPr><w:rFonts w:eastAsia="Times New Roman" w:cs="Arial"/><w:color w:val="auto"/><w:szCs w:val="22"/><w:u w:val="none"/><w:lang w:val="pl-PL" w:eastAsia="de-DE"/></w:rPr></w:pPr><w:r w:rsidRPr="00680DE3"><w:rPr><w:rFonts w:eastAsia="Times New Roman" w:cs="Arial"/><w:b/><w:bCs/><w:color w:val="auto"/><w:szCs w:val="22"/><w:u w:val="none"/><w:lang w:val="pl-PL" w:eastAsia="de-DE"/></w:rPr><w:lastRenderedPageBreak/><w:t>Pisz, co myślisz i czujesz:</w:t></w:r><w:r w:rsidRPr="00680DE3"><w:rPr><w:rFonts w:eastAsia="Times New Roman" w:cs="Arial"/><w:color w:val="auto"/><w:szCs w:val="22"/><w:u w:val="none"/><w:lang w:val="pl-PL" w:eastAsia="de-DE"/></w:rPr><w:t xml:space="preserve"> Tutaj możesz śmiało dzielić się swoimi refleksjami, porannymi wglądami i emocjami, które w Tobie rezonują.</w:t></w:r></w:p><w:p w14:paraId="16B07415" w14:textId="77777777" w:rsidR="00680DE3" w:rsidRPr="00680DE3" w:rsidRDefault="00680DE3" w:rsidP="00680DE3"><w:pPr><w:numPr><w:ilvl w:val="0"/><w:numId w:val="3"/></w:numPr><w:spacing w:before="100" w:beforeAutospacing="1" w:after="100" w:afterAutospacing="1" w:line="240" w:lineRule="auto"/><w:rPr><w:rFonts w:eastAsia="Times New Roman" w:cs="Arial"/><w:color w:val="auto"/><w:szCs w:val="22"/><w:u w:val="none"/><w:lang w:val="pl-PL" w:eastAsia="de-DE"/></w:rPr></w:pPr><w:r w:rsidRPr="00680DE3"><w:rPr><w:rFonts w:eastAsia="Times New Roman" w:cs="Arial"/><w:b/><w:bCs/><w:color w:val="auto"/><w:szCs w:val="22"/><w:u w:val="none"/><w:lang w:val="pl-PL" w:eastAsia="de-DE"/></w:rPr><w:t>Buduj siostrzane więzi:</w:t></w:r><w:r w:rsidRPr="00680DE3"><w:rPr><w:rFonts w:eastAsia="Times New Roman" w:cs="Arial"/><w:color w:val="auto"/><w:szCs w:val="22"/><w:u w:val="none"/><w:lang w:val="pl-PL" w:eastAsia="de-DE"/></w:rPr><w:t xml:space="preserve"> Komentuj, wspieraj inne kobiety i czerp energię z grupy, która doskonale Cię rozumie. Pamiętaj – w swoich poszukiwaniach, lękach i radościach nigdy nie jesteś sama. To miejsce wolne od oceniania, pełne empatii i wzajemnego zrozumienia.</w:t></w:r></w:p><w:p w14:paraId="0A620BF2" w14:textId="25804571" w:rsidR="00680DE3" w:rsidRPr="00680DE3" w:rsidRDefault="00680DE3" w:rsidP="00680DE3"><w:pPr><w:spacing w:before="100" w:beforeAutospacing="1" w:after="100" w:afterAutospacing="1" w:line="240" w:lineRule="auto"/><w:outlineLvl w:val="3"/><w:rPr><w:rFonts w:eastAsia="Times New Roman" w:cs="Arial"/><w:b/><w:bCs/><w:color w:val="auto"/><w:szCs w:val="22"/><w:lang w:val="pl-PL" w:eastAsia="de-DE"/></w:rPr></w:pPr><w:r w:rsidRPr="00680DE3"><w:rPr><w:rFonts w:eastAsia="Times New Roman" w:cs="Arial"/><w:b/><w:bCs/><w:color w:val="auto"/><w:szCs w:val="22"/><w:lang w:val="pl-PL" w:eastAsia="de-DE"/></w:rPr><w:t xml:space="preserve"> Wieczór: Czas na refleksję i uwolnienie</w:t></w:r></w:p><w:p w14:paraId="6E70ECDF" w14:textId="77777777" w:rsidR="00680DE3" w:rsidRPr="006