space="preserve">die Energie </w:t></w:r><w:r w:rsidRPr="00680DE3"><w:rPr><w:rFonts w:eastAsia="Times New Roman" w:cs="Arial" /><w:color w:val="auto" /><w:szCs w:val="22" /><w:u w:val="none" /><w:lang w:eastAsia="de-DE" /></w:rPr><w:t xml:space="preserve">des Tages</w:t></w:r><w:r w:rsidRPr="00680DE3"><w:rPr><w:rFonts w:eastAsia="Times New Roman" w:cs="Arial" /><w:color w:val="auto" /><w:szCs w:val="22" /><w:u w:val="none" /><w:lang w:eastAsia="de-DE" /></w:rPr><w:t xml:space="preserve">.</w:t></w:r></w:p><w:p w:rsidRPr="00680DE3" w:rsidR="00680DE3" w:rsidP="00680DE3" w:rsidRDefault="00680DE3" w14:paraId="13D917F5" w14:textId="77777777"><w:pPr><w:numPr><w:ilvl w:val="0" /><w:numId w:val="1" /></w:numPr><w:spacing w:before="100" w:beforeAutospacing="1" w:after="100" w:afterAutospacing="1" w:line="240" w:lineRule="auto" /><w:rPr><w:rFonts w:eastAsia="Times New Roman" w:cs="Arial" /><w:color w:val="auto" /><w:szCs w:val="22" /><w:u w:val="none" /><w:lang w:val="pl-PL" w:eastAsia="de-DE" /></w:rPr></w:pPr><w:r w:rsidRPr="00680DE3"><w:rPr><w:rFonts w:eastAsia="Times New Roman" w:cs="Arial" /><w:b /><w:bCs /><w:color w:val="auto" /><w:szCs w:val="22" /><w:u w:val="none" /><w:lang w:val="pl-PL" w:eastAsia="de-DE" /></w:rPr><w:t xml:space="preserve">Schau dir die Zahl des Tages </w:t></w:r><w:r w:rsidRPr="00680DE3"><w:rPr><w:rFonts w:eastAsia="Times New Roman" w:cs="Arial" /><w:color w:val="auto" /><w:szCs w:val="22" /><w:u w:val="none" /><w:lang w:val="pl-PL" w:eastAsia="de-DE" /></w:rPr><w:t xml:space="preserve">an</w:t></w:r><w:r w:rsidRPr="00680DE3"><w:rPr><w:rFonts w:eastAsia="Times New Roman" w:cs="Arial" /><w:b /><w:bCs /><w:color w:val="auto" /><w:szCs w:val="22" /><w:u w:val="none" /><w:lang w:val="pl-PL" w:eastAsia="de-DE" /></w:rPr><w:t xml:space="preserve">:</w:t></w:r><w:r w:rsidRPr="00680DE3"><w:rPr><w:rFonts w:eastAsia="Times New Roman" w:cs="Arial" /><w:color w:val="auto" /><w:szCs w:val="22" /><w:u w:val="none" /><w:lang w:val="pl-PL" w:eastAsia="de-DE" /></w:rPr><w:t xml:space="preserve"> Sieh dir an, welche Schwingung (von 1 bis 9) heute vorherrscht und welche Qualität sie mit sich bringt.</w:t></w:r></w:p><w:p w:rsidRPr="00680DE3" w:rsidR="00680DE3" w:rsidP="00680DE3" w:rsidRDefault="00680DE3" w14:paraId="0A78C209" w14:textId="77777777"><w:pPr><w:numPr><w:ilvl w:val="0" /><w:numId w:val="1" /></w:numPr><w:spacing w:before="100" w:beforeAutospacing="1" w:after="100" w:afterAutospacing="1" w:line="240" w:lineRule="auto" /><w:rPr><w:rFonts w:eastAsia="Times New Roman" w:cs="Arial" /><w:color w:val="auto" /><w:szCs w:val="22" /><w:u w:val="none" /><w:lang w:val="pl-PL" w:eastAsia="de-DE" /></w:rPr></w:pPr><w:r w:rsidRPr="00680DE3"><w:rPr><w:rFonts w:eastAsia="Times New Roman" w:cs="Arial" /><w:b /><w:bCs /><w:color w:val="auto" /><w:szCs w:val="22" /><w:u w:val="none" /><w:lang w:val="pl-PL" w:eastAsia="de-DE" /></w:rPr><w:t xml:space="preserve">Lies die kurze Beschreibung: </w:t></w:r><w:r w:rsidRPr="00680DE3"><w:rPr><w:rFonts w:eastAsia="Times New Roman" w:cs="Arial" /><w:color w:val="auto" /><w:szCs w:val="22" /><w:u w:val="none" /><w:lang w:val="pl-PL" w:eastAsia="de-DE" /></w:rPr><w:t xml:space="preserve">Lass die Worte der Beschreibung in dir nachklingen und schau, wie sie mit deinem Befinden in Einklang stehen.</w:t></w:r></w:p><w:p w:rsidRPr="00680DE3" w:rsidR="00680DE3" w:rsidP="00680DE3" w:rsidRDefault="00680DE3" w14:paraId="55B8974E" w14:textId="77777777"><w:pPr><w:numPr><w:ilvl w:val="0" /><w:numId w:val="1" /></w:numPr><w:spacing w:before="100" w:beforeAutospacing="1" w:after="100" w:afterAutospacing="1" w:line="240" w:lineRule="auto" /><w:rPr><w:rFonts w:eastAsia="Times New Roman" w:cs="Arial" /><w:color w:val="auto" /><w:szCs w:val="22" /><w:u w:val="none" /><w:lang w:val="pl-PL" w:eastAsia="de-DE" /></w:rPr></w:pPr><w:r w:rsidRPr="00680DE3"><w:rPr><w:rFonts w:eastAsia="Times New Roman" w:cs="Arial" /><w:b /><w:bCs /><w:color w:val="auto" /><w:szCs w:val="22" /><w:u w:val="none" /><w:lang w:val="pl-PL" w:eastAsia="de-DE" /></w:rPr><w:t xml:space="preserve">Schau </w:t></w:r><w:r w:rsidRPr="00680DE3"><w:rPr><w:rFonts w:eastAsia="Times New Roman" w:cs="Arial" /><w:color w:val="auto" /><w:szCs w:val="22" /><w:u w:val="none" /><w:lang w:val="pl-PL" w:eastAsia="de-DE" /></w:rPr><w:t xml:space="preserve">dir</w:t></w:r><w:r w:rsidRPr="00680DE3"><w:rPr><w:rFonts w:eastAsia="Times New Roman" w:cs="Arial" /><w:b /><w:bCs /><w:color w:val="auto" /><w:szCs w:val="22" /><w:u w:val="none" /><w:lang w:val="pl-PL" w:eastAsia="de-DE" /></w:rPr><w:t xml:space="preserve"> die Empfehlungen an: </w:t></w:r><w:r w:rsidRPr="00680DE3"><w:rPr><w:rFonts w:eastAsia="Times New Roman" w:cs="Arial" /><w:color w:val="auto" /><w:szCs w:val="22" /><w:u w:val="none" /><w:lang w:val="pl-PL" w:eastAsia="de-DE" /></w:rPr><w:t xml:space="preserve">Sieh dir an, welche Handlungen und Einstellungen dir heute eine natürliche Unterstützung bieten und welche Situationen du besser vermeiden solltest, um deine innere Harmonie zu bewahren.</w:t></w:r></w:p><w:p w:rsidRPr="00680DE3" w:rsidR="00680DE3" w:rsidP="00680DE3" w:rsidRDefault="00680DE3" w14:paraId="2591627B" w14:textId="42260FCC"><w:pPr><w:spacing w:before="100" w:beforeAutospacing="1" w:after="100" w:afterAutospacing="1" w:line="240" w:lineRule="auto" /><w:outlineLvl w:val="3" /><w:rPr><w:rFonts w:eastAsia="Times New Roman" w:cs="Arial" /><w:b /><w:bCs /><w:color w:val="auto" /><w:szCs w:val="22" /><w:lang w:val="pl-PL" w:eastAsia="de-DE" /></w:rPr></w:pPr><w:r w:rsidRPr="00680DE3"><w:rPr><w:rFonts w:eastAsia="Times New Roman" w:cs="Arial" /><w:b /><w:bCs /><w:color w:val="auto" /><w:szCs w:val="22" /><w:lang w:val="pl-PL" w:eastAsia="de-DE" /></w:rPr><w:t xml:space="preserve">Im Laufe des Tages: Ein Moment zum Durchatmen und… zum Lächeln!</w:t></w:r></w:p><w:p w:rsidRPr="00680DE3" w:rsidR="00680DE3" w:rsidP="00680DE3" w:rsidRDefault="00680DE3" w14:paraId="557BC5AD" w14:textId="77777777"><w:pPr><w:spacing w:before="100" w:beforeAutospacing="1" w:after="100" w:afterAutospacing="1" w:line="240" w:lineRule="auto" /><w:rPr><w:rFonts w:eastAsia="Times New Roman" w:cs="Arial" /><w:color w:val="auto" /><w:szCs w:val="22" /><w:u w:val="none" /><w:lang w:val="pl-PL" w:eastAsia="de-DE" /></w:rPr></w:pPr><w:r w:rsidRPr="00680DE3"><w:rPr><w:rFonts w:eastAsia="Times New Roman" w:cs="Arial" /><w:color w:val="auto" /><w:szCs w:val="22" /><w:u w:val="none" /><w:lang w:val="pl-PL" w:eastAsia="de-DE" /></w:rPr><w:t xml:space="preserve">Persönliche Entwicklung und die Arbeit mit Emotionen müssen keineswegs todernst sein. Manchmal ist das beste Mittel gegen im Körper festsitzende Anspannung einfach ein ehrliches, tiefes Lächeln.</w:t></w:r></w:p><w:p w:rsidRPr="00680DE3" w:rsidR="00680DE3" w:rsidP="00680DE3" w:rsidRDefault="00680DE3" w14:paraId="085B5225" w14:textId="77777777"><w:pPr><w:numPr><w:ilvl w:val="0" /><w:numId w:val="2" /></w:numPr><w:spacing w:before="100" w:beforeAutospacing="1" w:after="100" w:afterAutospacing="1" w:line="240" w:lineRule="auto" /><w:rPr><w:rFonts w:eastAsia="Times New Roman" w:cs="Arial" /><w:color w:val="auto" /><w:szCs w:val="22" /><w:u w:val="none" /><w:lang w:val="pl-PL" w:eastAsia="de-DE" /></w:rPr></w:pPr><w:r w:rsidRPr="00680DE3"><w:rPr><w:rFonts w:eastAsia="Times New Roman" w:cs="Arial" /><w:b /><w:bCs /><w:color w:val="auto" /><w:szCs w:val="22" /><w:u w:val="none" /><w:lang w:val="pl-PL" w:eastAsia="de-DE" /></w:rPr><w:t xml:space="preserve">Humor-Ecke: </w:t></w:r><w:r w:rsidRPr="00680DE3"><w:rPr><w:rFonts w:eastAsia="Times New Roman" w:cs="Arial" /><w:color w:val="auto" /><w:szCs w:val="22" /><w:u w:val="none" /><w:lang w:val="pl-PL" w:eastAsia="de-DE" /></w:rPr><w:t xml:space="preserve">Schau hier vorbei, wenn du das Gefühl hast, dass du deine Gedanken auf andere Dinge lenken musst. Ich habe für dich leichte, treffende und humorvolle Witze und Anekdoten vorbereitet. Gönne dir ein Lächeln – Lachen ist die schönste Art, Energie freizusetzen und die Last der Erwartungen von sich zu nehmen!</w:t></w:r></w:p><w:p w:rsidRPr="00680DE3" w:rsidR="00680DE3" w:rsidP="00680DE3" w:rsidRDefault="00680DE3" w14:paraId="326B162E" w14:textId="4938DCED"><w:pPr><w:spacing w:before="100" w:beforeAutospacing="1" w:after="100" w:afterAutospacing="1" w:line="240" w:lineRule="auto" /><w:outlineLvl w:val="3" /><w:rPr><w:rFonts w:eastAsia="Times New Roman" w:cs="Arial" /><w:b /><w:bCs /><w:color w:val="auto" /><w:szCs w:val="22" /><w:u w:val="none" /><w:lang w:val="pl-PL" w:eastAsia="de-DE" /></w:rPr></w:pPr><w:r w:rsidRPr="00680DE3"><w:rPr><w:rFonts w:eastAsia="Times New Roman" w:cs="Arial" /><w:b /><w:bCs /><w:color w:val="auto" /><w:szCs w:val="22" /><w:u w:val="none" /><w:lang w:val="pl-PL" w:eastAsia="de-DE" /></w:rPr><w:t xml:space="preserve"> Community-Bereich: Du bist unter Gleichgesinnten</w:t></w:r></w:p><w:p w:rsidRPr="00680DE3" w:rsidR="00680DE3" w:rsidP="00680DE3" w:rsidRDefault="00680DE3" w14:paraId="513EBA27" w14:textId="77777777"><w:pPr><w:spacing w:before="100" w:beforeAutospacing="1" w:after="100" w:afterAutospacing="1" w:line="240" w:lineRule="auto" /><w:rPr><w:rFonts w:eastAsia="Times New Roman" w:cs="Arial" /><w:color w:val="auto" /><w:szCs w:val="22" /><w:u w:val="none" /><w:lang w:val="pl-PL" w:eastAsia="de-DE" /></w:rPr></w:pPr><w:r w:rsidRPr="00680DE3"><w:rPr><w:rFonts w:eastAsia="Times New Roman" w:cs="Arial" /><w:color w:val="auto" /><w:szCs w:val="22" /><w:u w:val="none" /><w:lang w:val="pl-PL" w:eastAsia="de-DE" /></w:rPr><w:t xml:space="preserve">Dies ist einer der wichtigsten Bereiche in unserer App – das Herzstück von Numeronarracja. Ich habe diesen sicheren Raum speziell für Frauen geschaffen, die genau wie du ihre Masken ablegen und darüber sprechen möchten, was sie wirklich fühlen.</w:t></w:r></w:p><w:p w:rsidRPr="00680DE3" w:rsidR="00680DE3" w:rsidP="00680DE3" w:rsidRDefault="00680DE3" w14:paraId="6E784308" w14:textId="77777777"><w:pPr><w:numPr><w:ilvl w:val="0" /><w:numId w:val="3" /></w:numPr><w:spacing w:before="100" w:beforeAutospacing="1" w:after="100" w:afterAutospacing="1" w:line="240" w:lineRule="auto" /><w:rPr><w:rFonts w:eastAsia="Times New Roman" w:cs="Arial" /><w:color w:val="auto" /><w:szCs w:val="22" /><w:u w:val="none" /><w:lang w:val="pl-PL" w:eastAsia="de-DE" /></w:rPr></w:pPr><w:r w:rsidRPr="00680DE3"><w:rPr><w:rFonts w:eastAsia="Times New Roman" w:cs="Arial" /><w:b /><w:bCs /><w:color w:val="auto" /><w:szCs w:val="22" /><w:u w:val="none" /><w:lang w:val="pl-PL" w:eastAsia="de-DE" /></w:rPr><w:lastRenderedPageBreak /></w:r><w:r w:rsidRPr="00680DE3"><w:rPr><w:rFonts w:eastAsia="Times New Roman" w:cs="Arial" /><w:b /><w:bCs /><w:color w:val="auto" /><w:szCs w:val="22" /><w:u w:val="none" /><w:lang w:val="pl-PL" w:eastAsia="de-DE" /></w:rPr><w:t xml:space="preserve">Schreibe, was du denkst und fühlst: </w:t></w:r><w:r w:rsidRPr="00680DE3"><w:rPr><w:rFonts w:eastAsia="Times New Roman" w:cs="Arial" /><w:color w:val="auto" /><w:szCs w:val="22" /><w:u w:val="none" /><w:lang w:val="pl-PL" w:eastAsia="de-DE" /></w:rPr><w:t xml:space="preserve">Hier kannst du ganz offen deine Gedanken, morgendlichen Einsichten und Emotionen teilen, die in dir nachhallen.</w:t></w:r></w:p><w:p w:rsidRPr="00680DE3" w:rsidR="00680DE3" w:rsidP="00680DE3" w:rsidRDefault="00680DE3" w14:paraId="16B07415" w14:textId="77777777"><w:pPr><w:numPr><w:ilvl w:val="0" /><w:numId w:val="3" /></w:numPr><w:spacing w:before="100" w:beforeAutospacing="1" w:after="100" w:afterAutospacing="1" w:line="240" w:lineRule="auto" /><w:rPr><w:rFonts w:eastAsia="Times New Roman" w:cs="Arial" /><w:color w:val="auto" /><w:szCs w:val="22" /><w:u w:val="none" /><w:lang w:val="pl-PL" w:eastAsia="de-DE" /></w:rPr></w:pPr><w:r w:rsidRPr="00680DE3"><w:rPr><w:rFonts w:eastAsia="Times New Roman" w:cs="Arial" /><w:b /><w:bCs /><w:color w:val="auto" /><w:szCs w:val="22" /><w:u w:val="none" /><w:lang w:val="pl-PL" w:eastAsia="de-DE" /></w:rPr><w:t xml:space="preserve">Baue Schwesternbeziehungen auf: </w:t></w:r><w:r w:rsidRPr="00680DE3"><w:rPr><w:rFonts w:eastAsia="Times New Roman" w:cs="Arial" /><w:color w:val="auto" /><w:szCs w:val="22" /><w:u w:val="none" /><w:lang w:val="pl-PL" w:eastAsia="de-DE" /></w:rPr><w:t xml:space="preserve">Kommentiere, unterstütze andere Frauen und schöpfe Energie aus einer Gruppe, die dich perfekt versteht. Denk daran – bei deinen Suchprozessen, Ängsten und Freuden bist du niemals allein. Dies ist ein Ort frei von Urteilen, voller Empathie und gegenseitigem Verständnis.</w:t></w:r></w:p><w:p w:rsidRPr="00680DE3" w:rsidR="00680DE3" w:rsidP="00680DE3" w:rsidRDefault="00680DE3" w14:paraId="0A620BF2" w14:textId="25804571"><w:pPr><w:spacing w:before="100" w:beforeAutospacing="1" w:after="100" w:afterAutospacing="1" w:line="240" w:lineRule="auto" /><w:outlineLvl w:val="3" /><w:rPr><w:rFonts w:eastAsia="Times New Roman" w:cs="Arial" /><w:b /><w:bCs /><w:color w:val="auto" /><w:szCs w:val="22" /><w:lang w:val="pl-PL" w:eastAsia="de-DE" /></w:rPr></w:pPr><w:r w:rsidRPr="00680DE3"><w:rPr><w:rFonts w:eastAsia="Times New Roman" w:cs="Arial" /><w:b /><w:bCs /><w:color w:val="auto" /><w:szCs w:val="22" /><w:lang w:val="pl-PL" w:eastAsia="de-DE" /></w:rPr><w:t xml:space="preserve"> Abend: Zeit für Reflexion und Loslassen</w:t></w:r></w:p><w:p w:rsidRPr="00680DE3" w:rsidR="00680DE3" w:rsidP="00680DE3" w:rsidRDefault="00680DE3" w14:paraId="6E70ECDF" w14:textId="77777777"><w:pPr><w:spacing w:before="100" w:beforeAutospacing="1" w:after="100" w:afterAutospacing="1" w:line="240" w:lineRule="auto" /><w:rPr><w:rFonts w:eastAsia="Times New Roman" w:cs="Arial" /><w:color w:val="auto" /><w:szCs w:val="22" /><w:u w:val="none" /><w:lang w:eastAsia="de-DE" /></w:rPr></w:pPr><w:r w:rsidRPr="00680DE3"><w:rPr><w:rFonts w:eastAsia="Times New Roman" w:cs="Arial" /><w:color w:val="auto" /><w:szCs w:val="22" /><w:u w:val="none" /><w:lang w:val="pl-PL" w:eastAsia="de-DE" /></w:rPr><w:t xml:space="preserve">Am Ende des Tages, wenn die Welt um dich herum zur Ruhe kommt, gönne dir ein paar Minuten, um noch einmal in die Ap