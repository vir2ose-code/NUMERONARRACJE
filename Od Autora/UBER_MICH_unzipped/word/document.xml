<w:document xmlns:wpc="http://schemas.microsoft.com/office/word/2010/wordprocessingCanvas" xmlns:cx="http://schemas.microsoft.com/office/drawing/2014/chartex" xmlns:cx1="http://schemas.microsoft.com/office/drawing/2015/9/8/chartex" xmlns:cx2="http://schemas.microsoft.com/office/drawing/2015/10/21/chartex" xmlns:cx3="http://schemas.microsoft.com/office/drawing/2016/5/9/chartex" xmlns:cx4="http://schemas.microsoft.com/office/drawing/2016/5/10/chartex" xmlns:cx5="http://schemas.microsoft.com/office/drawing/2016/5/11/chartex" xmlns:cx6="http://schemas.microsoft.com/office/drawing/2016/5/12/chartex" xmlns:cx7="http://schemas.microsoft.com/office/drawing/2016/5/13/chartex" xmlns:cx8="http://schemas.microsoft.com/office/drawing/2016/5/14/chartex" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:aink="http://schemas.microsoft.com/office/drawing/2016/ink" xmlns:am3d="http://schemas.microsoft.com/office/drawing/2017/model3d" xmlns:o="urn:schemas-microsoft-com:office:office" xmlns:r="http://schemas.openxmlformats.org/officeDocument/2006/relationships" xmlns:m="http://schemas.openxmlformats.org/officeDocument/2006/math" xmlns:v="urn:schemas-microsoft-com:vml" xmlns:wp14="http://schemas.microsoft.com/office/word/2010/wordprocessingDrawing" xmlns:wp="http://schemas.openxmlformats.org/drawingml/2006/wordprocessingDrawing" xmlns:w10="urn:schemas-microsoft-com:office:word" xmlns:w="http://schemas.openxmlformats.org/wordprocessingml/2006/main" xmlns:w14="http://schemas.microsoft.com/office/word/2010/wordml" xmlns:w15="http://schemas.microsoft.com/office/word/2012/wordml" xmlns:w16cex="http://schemas.microsoft.com/office/word/2018/wordml/cex" xmlns:w16cid="http://schemas.microsoft.com/office/word/2016/wordml/cid" xmlns:w16="http://schemas.microsoft.com/office/word/2018/wordml" xmlns:w16sdtdh="http://schemas.microsoft.com/office/word/2020/wordml/sdtdatahash" xmlns:w16se="http://schemas.microsoft.com/office/word/2015/wordml/symex" xmlns:wpg="http://schemas.microsoft.com/office/word/2010/wordprocessingGroup" xmlns:wpi="http://schemas.microsoft.com/office/word/2010/wordprocessingInk" xmlns:wne="http://schemas.microsoft.com/office/word/2006/wordml" xmlns:wps="http://schemas.microsoft.com/office/word/2010/wordprocessingShape" mc:Ignorable="w14 w15 w16se w16cid w16 w16cex w16sdtdh wp14"><w:body><w:p w14:paraId="4648FD69" w14:textId="6AB7D453" w:rsidR="00512C39" w:rsidRPr="00F33A82" w:rsidRDefault="00512C39" w:rsidP="00512C39"><w:pPr><w:spacing w:before="100" w:beforeAutospacing="1" w:after="100" w:afterAutospacing="1" w:line="240" w:lineRule="auto"/><w:outlineLvl w:val="1"/><w:rPr><w:rFonts w:ascii="Times New Roman" w:eastAsia="Times New Roman" w:hAnsi="Times New Roman"/><w:b/><w:bCs/><w:color w:val="auto"/><w:sz w:val="36"/><w:szCs w:val="36"/><w:u w:val="none"/><w:lang w:eastAsia="de-DE"/></w:rPr></w:pPr><w:r w:rsidRPr="00F33A82"><w:rPr><w:rFonts w:ascii="Times New Roman" w:eastAsia="Times New Roman" w:hAnsi="Times New Roman"/><w:b/><w:bCs/><w:color w:val="auto"/><w:sz w:val="36"/><w:szCs w:val="36"/><w:u w:val="none"/><w:lang w:eastAsia="de-DE"/></w:rPr><w:t>L</w:t></w:r><w:r w:rsidR="00F33A82"><w:rPr><w:rFonts w:ascii="Times New Roman" w:eastAsia="Times New Roman" w:hAnsi="Times New Roman"/><w:b/><w:bCs/><w:color w:val="auto"/><w:sz w:val="36"/><w:szCs w:val="36"/><w:u w:val="none"/><w:lang w:eastAsia="de-DE"/></w:rPr><w:t xml:space="preserve">ass </w:t></w:r><w:r w:rsidRPr="00F33A82"><w:rPr><w:rFonts w:ascii="Times New Roman" w:eastAsia="Times New Roman" w:hAnsi="Times New Roman"/><w:b/><w:bCs/><w:color w:val="auto"/><w:sz w:val="36"/><w:szCs w:val="36"/><w:u w:val="none"/><w:lang w:eastAsia="de-DE"/></w:rPr><w:t>uns näher kennen</w:t></w:r><w:r w:rsidR="00F33A82"><w:rPr><w:rFonts w:ascii="Times New Roman" w:eastAsia="Times New Roman" w:hAnsi="Times New Roman"/><w:b/><w:bCs/><w:color w:val="auto"/><w:sz w:val="36"/><w:szCs w:val="36"/><w:u w:val="none"/><w:lang w:eastAsia="de-DE"/></w:rPr><w:t>lernen</w:t></w:r></w:p><w:p w14:paraId="792E72EB" w14:textId="1038F653" w:rsidR="00512C39" w:rsidRPr="00F33A82" w:rsidRDefault="00512C39" w:rsidP="00512C39"><w:pPr><w:spacing w:before="100" w:beforeAutospacing="1" w:after="100" w:afterAutospacing="1" w:line="240" w:lineRule="auto"/><w:rPr><w:rFonts w:ascii="Times New Roman" w:eastAsia="Times New Roman" w:hAnsi="Times New Roman"/><w:color w:val="auto"/><w:sz w:val="24"/><w:szCs w:val="24"/><w:u w:val="none"/><w:lang w:eastAsia="de-DE"/></w:rPr></w:pPr><w:r w:rsidRPr="00F33A82"><w:rPr><w:rFonts w:ascii="Times New Roman" w:eastAsia="Times New Roman" w:hAnsi="Times New Roman"/><w:color w:val="auto"/><w:sz w:val="24"/><w:szCs w:val="24"/><w:u w:val="none"/><w:lang w:eastAsia="de-DE"/></w:rPr><w:t xml:space="preserve">Hallo! Da du hier bist, bedeutet das, dass unsere gemeinsame Reise gerade beginnt. Mein Name ist </w:t></w:r><w:r w:rsidR="009A3DAD" w:rsidRPr="00F33A82"><w:rPr><w:rFonts w:ascii="Times New Roman" w:eastAsia="Times New Roman" w:hAnsi="Times New Roman"/><w:color w:val="auto"/><w:sz w:val="24"/><w:szCs w:val="24"/><w:u w:val="none"/><w:lang w:eastAsia="de-DE"/></w:rPr><w:t xml:space="preserve">Renata Mickiewicz-Krucinski, ich bin </w:t></w:r><w:r w:rsidRPr="00F33A82"><w:rPr><w:rFonts w:ascii="Times New Roman" w:eastAsia="Times New Roman" w:hAnsi="Times New Roman"/><w:color w:val="auto"/><w:sz w:val="24"/><w:szCs w:val="24"/><w:u w:val="none"/><w:lang w:eastAsia="de-DE"/></w:rPr><w:t xml:space="preserve">die Gründerin von Numeronarracja, aber vor allem bin ich eine Frau, die über Jahre hinweg gelernt hat, nicht mehr gegen sich selbst anzukämpfen, sondern auf sich selbst zu hören. </w:t></w:r></w:p><w:p w14:paraId="05FB900B" w14:textId="77777777" w:rsidR="00512C39" w:rsidRPr="00F33A82" w:rsidRDefault="00512C39" w:rsidP="00512C39"><w:pPr><w:spacing w:before="100" w:beforeAutospacing="1" w:after="100" w:afterAutospacing="1" w:line="240" w:lineRule="auto"/><w:rPr><w:rFonts w:ascii="Times New Roman" w:eastAsia="Times New Roman" w:hAnsi="Times New Roman"/><w:color w:val="auto"/><w:sz w:val="24"/><w:szCs w:val="24"/><w:u w:val="none"/><w:lang w:eastAsia="de-DE"/></w:rPr></w:pPr><w:r w:rsidRPr="00F33A82"><w:rPr><w:rFonts w:ascii="Times New Roman" w:eastAsia="Times New Roman" w:hAnsi="Times New Roman"/><w:color w:val="auto"/><w:sz w:val="24"/><w:szCs w:val="24"/><w:u w:val="none"/><w:lang w:eastAsia="de-DE"/></w:rPr><w:t xml:space="preserve">Mein Weg zu dem Punkt, an dem ich heute stehe, war keine plötzliche Wendung, sondern ein natürlicher, schöner Reifeprozess. Seit ich mich erinnern kann, haben mich drei Dinge fasziniert: Zahlen, Kunst und Menschen. Diese Kombination hat mich in jeder Lebensphase begleitet, auch wenn sie mit der Zeit ganz neue, tiefere Facetten angenommen hat. </w:t></w:r></w:p><w:p w14:paraId="1ED1B46A" w14:textId="77777777" w:rsidR="00512C39" w:rsidRPr="00F33A82" w:rsidRDefault="00512C39" w:rsidP="00512C39"><w:pPr><w:spacing w:before="100" w:beforeAutospacing="1" w:after="100" w:afterAutospacing="1" w:line="240" w:lineRule="auto"/><w:outlineLvl w:val="2"/><w:rPr><w:rFonts w:ascii="Times New Roman" w:eastAsia="Times New Roman" w:hAnsi="Times New Roman"/><w:b/><w:bCs/><w:color w:val="auto"/><w:sz w:val="27"/><w:szCs w:val="27"/><w:u w:val="none"/><w:lang w:eastAsia="de-DE"/></w:rPr></w:pPr><w:r w:rsidRPr="00F33A82"><w:rPr><w:rFonts w:ascii="Times New Roman" w:eastAsia="Times New Roman" w:hAnsi="Times New Roman"/><w:b/><w:bCs/><w:color w:val="auto"/><w:sz w:val="27"/><w:szCs w:val="27"/><w:u w:val="none"/><w:lang w:eastAsia="de-DE"/></w:rPr><w:t>Von der Präzision der Zahlen zur Tiefe der menschlichen Natur</w:t></w:r></w:p><w:p w14:paraId="6E0305BF" w14:textId="77777777" w:rsidR="00512C39" w:rsidRPr="00F33A82" w:rsidRDefault="00512C39" w:rsidP="00512C39"><w:pPr><w:spacing w:before="100" w:beforeAutospacing="1" w:after="100" w:afterAutospacing="1" w:line="240" w:lineRule="auto"/><w:rPr><w:rFonts w:ascii="Times New Roman" w:eastAsia="Times New Roman" w:hAnsi="Times New Roman"/><w:color w:val="auto"/><w:sz w:val="24"/><w:szCs w:val="24"/><w:u w:val="none"/><w:lang w:eastAsia="de-DE"/></w:rPr></w:pPr><w:r w:rsidRPr="00F33A82"><w:rPr><w:rFonts w:ascii="Times New Roman" w:eastAsia="Times New Roman" w:hAnsi="Times New Roman"/><w:color w:val="auto"/><w:sz w:val="24"/><w:szCs w:val="24"/><w:u w:val="none"/><w:lang w:eastAsia="de-DE"/></w:rPr><w:t xml:space="preserve">Es mag dich überraschen, aber mein beruflicher Weg begann … in der Finanzwelt. Schon in der Schule nahm ich mit Leidenschaft am Mathematik-AG teil und liebte den Moment, in dem sich das Datenchaos zu einer klaren, logischen Struktur fügte. Diese Liebe zur Ordnung führte mich über das Studium der Buchhaltung direkt in die Welt der Steuern und der Buchhaltung. Jahrelang habe ich Zahlen analysiert, auf der Suche nach Fehlern und Fakten. </w:t></w:r></w:p><w:p w14:paraId="050055EB" w14:textId="064AE713" w:rsidR="00512C39" w:rsidRPr="00F33A82" w:rsidRDefault="00512C39" w:rsidP="00512C39"><w:pPr><w:spacing w:before="100" w:beforeAutospacing="1" w:after="100" w:afterAutospacing="1" w:line="240" w:lineRule="auto"/><w:rPr><w:rFonts w:ascii="Times New Roman" w:eastAsia="Times New Roman" w:hAnsi="Times New Roman"/><w:color w:val="auto"/><w:sz w:val="24"/><w:szCs w:val="24"/><w:u w:val="none"/><w:lang w:eastAsia="de-DE"/></w:rPr></w:pPr><w:r w:rsidRPr="00F33A82"><w:rPr><w:rFonts w:ascii="Times New Roman" w:eastAsia="Times New Roman" w:hAnsi="Times New Roman"/><w:color w:val="auto"/><w:sz w:val="24"/><w:szCs w:val="24"/><w:u w:val="none"/><w:lang w:eastAsia="de-DE"/></w:rPr><w:t xml:space="preserve">Heute dienen mir dieselben Zahlen für etwas viel Tiefgründigeres – um die menschliche Natur, Emotionen und verborgenes Potenzial zu entschlüsseln. Ich habe verstanden, dass Zahlen nicht nur ein Werkzeug zum Zählen von Materie sind, sondern ein mächtiger Code, der es ermöglicht, die Mechanismen unseres Verhaltens und Blockaden </w:t></w:r><w:r w:rsidR="009A3DAD" w:rsidRPr="00F33A82"><w:rPr><w:rFonts w:ascii="Times New Roman" w:eastAsia="Times New Roman" w:hAnsi="Times New Roman"/><w:color w:val="auto"/><w:sz w:val="24"/><w:szCs w:val="24"/><w:u w:val="none"/><w:lang w:eastAsia="de-DE"/></w:rPr><w:t xml:space="preserve">in </w:t></w:r><w:r w:rsidRPr="00F33A82"><w:rPr><w:rFonts w:ascii="Times New Roman" w:eastAsia="Times New Roman" w:hAnsi="Times New Roman"/><w:color w:val="auto"/><w:sz w:val="24"/><w:szCs w:val="24"/><w:u w:val="none"/><w:lang w:eastAsia="de-DE"/></w:rPr><w:t xml:space="preserve">Beziehungen zu verstehen. Als reife Frau weiß ich genau, wie es ist, sich in seinem eigenen Leben einsam zu fühlen, obwohl man eine Familie, einen Beruf und alltägliche Pflichten hat. Ich weiß, wie erschöpfend der innere Kampf mit sich selbst sein kann und der Versuch, den Erwartungen der Welt gerecht zu werden, während man die eigenen Bedürfnisse vergisst. </w:t></w:r></w:p><w:p w14:paraId="78ECD0A4" w14:textId="182219F3" w:rsidR="00512C39" w:rsidRPr="00F33A82" w:rsidRDefault="00512C39" w:rsidP="00512C39"><w:pPr><w:spacing w:before="100" w:beforeAutospacing="1" w:after="100" w:afterAutospacing="1" w:line="240" w:lineRule="auto"/><w:rPr><w:rFonts w:ascii="Times New Roman" w:eastAsia="Times New Roman" w:hAnsi="Times New Roman"/><w:color w:val="auto"/><w:sz w:val="24"/><w:szCs w:val="24"/><w:u w:val="none"/><w:lang w:eastAsia="de-DE"/></w:rPr></w:pPr><w:r w:rsidRPr="00F33A82"><w:rPr><w:rFonts w:ascii="Times New Roman" w:eastAsia="Times New Roman" w:hAnsi="Times New Roman"/><w:color w:val="auto"/><w:sz w:val="24"/><w:szCs w:val="24"/><w:u w:val="none"/><w:lang w:eastAsia="de-DE"/></w:rPr><w:t xml:space="preserve">Meine eigene Reise durch die numerologische Landkarte brachte </w:t></w:r><w:r w:rsidR="009A3DAD" w:rsidRPr="00F33A82"><w:rPr><w:rFonts w:ascii="Times New Roman" w:eastAsia="Times New Roman" w:hAnsi="Times New Roman"/><w:color w:val="auto"/><w:sz w:val="24"/><w:szCs w:val="24"/><w:u w:val="none"/><w:lang w:eastAsia="de-DE"/></w:rPr><w:t xml:space="preserve">mir </w:t></w:r><w:r w:rsidRPr="00F33A82"><w:rPr><w:rFonts w:ascii="Times New Roman" w:eastAsia="Times New Roman" w:hAnsi="Times New Roman"/><w:color w:val="auto"/><w:sz w:val="24"/><w:szCs w:val="24"/><w:u w:val="none"/><w:lang w:eastAsia="de-DE"/></w:rPr><w:t xml:space="preserve">einen Durchbruch – </w:t></w:r><w:r w:rsidR="009A3DAD" w:rsidRPr="00F33A82"><w:rPr><w:rFonts w:ascii="Times New Roman" w:eastAsia="Times New Roman" w:hAnsi="Times New Roman"/><w:color w:val="auto"/><w:sz w:val="24"/><w:szCs w:val="24"/><w:u w:val="none"/><w:lang w:eastAsia="de-DE"/></w:rPr><w:t>sie ermöglichte es mir</w:t></w:r><w:r w:rsidRPr="00F33A82"><w:rPr><w:rFonts w:ascii="Times New Roman" w:eastAsia="Times New Roman" w:hAnsi="Times New Roman"/><w:color w:val="auto"/><w:sz w:val="24"/><w:szCs w:val="24"/><w:u w:val="none"/><w:lang w:eastAsia="de-DE"/></w:rPr><w:t xml:space="preserve">, aufzuhören, mit mir selbst zu kämpfen, meine Emotionen zu verstehen, verborgene Talente zu benennen und mich selbst mit tiefer Zärtlichkeit zu betrachten. Genau diese Erfahrung wurde zu meiner Mission. </w:t></w:r></w:p><w:p w14:paraId="300D0D3A" w14:textId="77777777" w:rsidR="00512C39" w:rsidRPr="00F33A82" w:rsidRDefault="00512C39" w:rsidP="00512C39"><w:pPr><w:spacing w:before="100" w:beforeAutospacing="1" w:after="100" w:afterAutospacing="1" w:line="240" w:lineRule="auto"/><w:outlineLvl w:val="2"/><w:rPr><w:rFonts w:ascii="Times New Roman" w:eastAsia="Times New Roman" w:hAnsi="Times New Roman"/><w:b/><w:bCs/><w:color w:val="auto"/><w:sz w:val="27"/><w:szCs w:val="27"/><w:u w:val="none"/><w:lang w:eastAsia="de-DE"/></w:rPr></w:pPr><w:r w:rsidRPr="00F33A82"><w:rPr><w:rFonts w:ascii="Times New Roman" w:eastAsia="Times New Roman" w:hAnsi="Times New Roman"/><w:b/><w:bCs/><w:color w:val="auto"/><w:sz w:val="27"/><w:szCs w:val="27"/><w:u w:val="none"/><w:lang w:eastAsia="de-DE"/></w:rPr><w:t>Die Seele einer Künstlerin, Kreativität und die Kraft der Geschichten</w:t></w:r></w:p><w:p w14:paraId="7FC14867" w14:textId="77777777" w:rsidR="00512C39" w:rsidRPr="00F33A82" w:rsidRDefault="00512C39" w:rsidP="00512C39"><w:pPr><w:spacing w:before="100" w:beforeAutospacing="1" w:after="100" w:afterAutospacing="1" w:line="240" w:lineRule="auto"/><w:rPr><w:rFonts w:ascii="Times New Roman" w:eastAsia="Times New Roman" w:hAnsi="Times New Roman"/><w:color w:val="auto"/><w:sz w:val="24"/><w:szCs w:val="24"/><w:u w:val="none"/><w:lang w:eastAsia="de-DE"/></w:rPr></w:pPr><w:r w:rsidRPr="00F33A82"><w:rPr><w:rFonts w:ascii="Times New Roman" w:eastAsia="Times New Roman" w:hAnsi="Times New Roman"/><w:color w:val="auto"/><w:sz w:val="24"/><w:szCs w:val="24"/><w:u w:val="none"/><w:lang w:eastAsia="de-DE"/></w:rPr><w:t xml:space="preserve">Neben dem analytischen Verstand einer ehemaligen Buchhalterin schlägt in mir das lebendige Herz einer Künstlerin und einer kreativen Seele. Meine Faszination für die Kunst und das menschliche Innere hat mich dazu gebracht, meine Emotionen zu Papier zu bringen. Ich schaffe mit der Absicht, dass das Wort Trost spendet, Mut macht und dabei hilft, das zu entschlüsseln, was in uns blockiert ist. </w:t></w:r></w:p><w:p w14:paraId="35038B8F" w14:textId="77777777" w:rsidR="00512C39" w:rsidRPr="00F33A82" w:rsidRDefault="00512C39" w:rsidP="00512C39"><w:pPr><w:numPr><w:ilvl w:val="0"/><w:numId w:val="1"/></w:numPr><w:spacing w:before="100" w:beforeAutospacing="1" w:after="100" w:afterAutospacing="1" w:line="240" w:lineRule="auto"/><w:rPr><w:rFonts w:ascii="Times New Roman" w:eastAsia="Times New Roman" w:hAnsi="Times New Roman"/><w:color w:val="auto"/><w:sz w:val="24"/><w:szCs w:val="24"/><w:u w:val="none"/><w:lang w:eastAsia="de-DE"/></w:rPr></w:pPr><w:r w:rsidRPr="00F33A82"><w:rPr><w:rFonts w:ascii="Times New Roman" w:eastAsia="Times New Roman" w:hAnsi="Times New Roman"/><w:b/><w:bCs/><w:color w:val="auto"/><w:sz w:val="24"/><w:szCs w:val="24"/><w:u w:val="none"/><w:lang w:eastAsia="de-DE"/></w:rPr><w:t xml:space="preserve">Märchen für Kinder über Emotionen: </w:t></w:r><w:r w:rsidRPr="00F33A82"><w:rPr><w:rFonts w:ascii="Times New Roman" w:eastAsia="Times New Roman" w:hAnsi="Times New Roman"/><w:color w:val="auto"/><w:sz w:val="24"/><w:szCs w:val="24"/><w:u w:val="none"/><w:lang w:eastAsia="de-DE"/></w:rPr><w:t>Ich schreibe Geschichten für die Kleinsten, um ihnen von klein auf beizubringen, dass sie mit ihren Gefühlen nicht allein sind. Ich möchte Kindern den Mut geben, darüber zu sprechen, was sie erleben, was sie traurig macht oder wütend.</w:t></w:r></w:p><w:p w14:paraId="640DB567" w14:textId="106544CC" w:rsidR="00512C39" w:rsidRPr="00F33A82" w:rsidRDefault="00512C39" w:rsidP="00512C39"><w:pPr><w:numPr><w:ilvl w:val="0"/><w:numId w:val="1"/></w:numPr><w:spacing w:before="100" w:beforeAutospacing="1" w:after="100" w:afterAutospacing="1" w:line="240" w:lineRule="auto"/><w:rPr><w:rFonts w:ascii="Times New Roman" w:eastAsia="Times New Roman" w:hAnsi="Times New Roman"/><w:color w:val="auto"/><w:sz w:val="24"/><w:szCs w:val="24"/><w:u w:val="none"/><w:lang w:eastAsia="de-DE"/></w:rPr></w:pPr><w:r w:rsidRPr="00F33A82"><w:rPr><w:rFonts w:ascii="Times New Roman" w:eastAsia="Times New Roman" w:hAnsi="Times New Roman"/><w:b/><w:bCs/><w:color w:val="auto"/><w:sz w:val="24"/><w:szCs w:val="24"/><w:u w:val="none"/><w:lang w:eastAsia="de-DE"/></w:rPr><w:t xml:space="preserve">Personalisierte Geschichten für Erwachsene: </w:t></w:r><w:r w:rsidRPr="00F33A82"><w:rPr><w:rFonts w:ascii="Times New Roman" w:eastAsia="Times New Roman" w:hAnsi="Times New Roman"/><w:color w:val="auto"/><w:sz w:val="24"/><w:szCs w:val="24"/><w:u w:val="none"/><w:lang w:eastAsia="de-DE"/></w:rPr><w:t xml:space="preserve">Auf der Grundlage des Geburtsdatums erstelle ich persönliche Erzählungen. Es sind einzigartige, literarische Spiegel, die Erwachsenen helfen, sich Talente und Potenziale bewusst zu machen, von </w:t></w:r><w:r w:rsidRPr="00F33A82"><w:rPr><w:rFonts w:ascii="Times New Roman" w:eastAsia="Times New Roman" w:hAnsi="Times New Roman"/><w:color w:val="auto"/><w:sz w:val="24"/><w:szCs w:val="24"/><w:u w:val="none"/><w:lang w:eastAsia="de-DE"/></w:rPr><w:lastRenderedPageBreak/><w:t>deren Existenz sie oft keine Ahnung hatten, weil sie von alten Mustern und Überzeugungen verdeckt wurden.</w:t></w:r></w:p><w:p w14:paraId="4584D904" w14:textId="77777777" w:rsidR="009A3DAD" w:rsidRPr="00F33A82" w:rsidRDefault="009A3DAD" w:rsidP="00512C39"><w:pPr><w:spacing w:before="100" w:beforeAutospacing="1" w:after="100" w:afterAutospacing="1" w:line="240" w:lineRule="auto"/><w:outlineLvl w:val="2"/><w:rPr><w:rFonts w:ascii="Times New Roman" w:eastAsia="Times New Roman" w:hAnsi="Times New Roman"/><w:b/><w:bCs/><w:color w:val="auto"/><w:sz w:val="27"/><w:szCs w:val="27"/><w:u w:val="none"/><w:lang w:eastAsia="de-DE"/></w:rPr></w:pPr></w:p><w:p w14:paraId="7FD5084D" w14:textId="77777777" w:rsidR="009A3DAD" w:rsidRPr="00F33A82" w:rsidRDefault="009A3DAD" w:rsidP="00512C39"><w:pPr><w:spacing w:before="100" w:beforeAutospacing="1" w:after="100" w:afterAutospacing="1" w:line="240" w:lineRule="auto"/><w:outlineLvl w:val="2"/><w:rPr><w:rFonts w:ascii="Times New Roman" w:eastAsia="Times New Roman" w:hAnsi="Times New Roman"/><w:b/><w:bCs/><w:color w:val="auto"/><w:sz w:val="27"/><w:szCs w:val="27"/><w:u w:val="none"/><w:lang w:eastAsia="de-DE"/></w:rPr></w:pPr></w:p><w:p w14:paraId="7CF5230E" w14:textId="148650C3" w:rsidR="00512C39" w:rsidRPr="00F33A82" w:rsidRDefault="00512C39" w:rsidP="00512C39"><w:pPr><w:spacing w:before="100" w:beforeAutospacing="1" w:after="100" w:afterAutospacing="1" w:line="240" w:lineRule="auto"/><w:outlineLvl w:val="2"/><w:rPr><w:rFonts w:ascii="Times New Roman" w:eastAsia="Times New Roman" w:hAnsi="Times New Roman"/><w:b/><w:bCs/><w:color w:val="auto"/><w:sz w:val="27"/><w:szCs w:val="27"/><w:u w:val="none"/><w:lang w:eastAsia="de-DE"/></w:rPr></w:pPr><w:r w:rsidRPr="00F33A82"><w:rPr><w:rFonts w:ascii="Times New Roman" w:eastAsia="Times New Roman" w:hAnsi="Times New Roman"/><w:b/><w:bCs/><w:color w:val="auto"/><w:sz w:val="27"/><w:szCs w:val="27"/><w:u w:val="none"/><w:lang w:eastAsia="de-DE"/></w:rPr><w:t>Mit einem Lächeln durchs Leben (auch wenn es nichts zu lachen gibt)</w:t></w:r></w:p><w:p w14:paraId="634ECCD7" w14:textId="77777777" w:rsidR="00512C39" w:rsidRPr="00F33A82" w:rsidRDefault="00512C39" w:rsidP="00512C39"><w:pPr><w:spacing w:before="100" w:beforeAutospacing="1" w:after="100" w:afterAutospacing="1" w:line="240" w:lineRule="auto"/><w:rPr><w:rFonts w:ascii="Times New Roman" w:eastAsia="Times New Roman" w:hAnsi="Times New Roman"/><w:color w:val="auto"/><w:sz w:val="24"/><w:szCs w:val="24"/><w:u w:val="none"/><w:lang w:eastAsia="de-DE"/></w:rPr></w:pPr><w:r w:rsidRPr="00F33A82"><w:rPr><w:rFonts w:ascii="Times New Roman" w:eastAsia="Times New Roman" w:hAnsi="Times New Roman"/><w:color w:val="auto"/><w:sz w:val="24"/><w:szCs w:val="24"/><w:u w:val="none"/><w:lang w:eastAsia="de-DE"/></w:rPr><w:t>Ich glaube, dass der Schlüssel zu einem guten Leben darin liegt, die Welt positiv und mit einem Lächeln zu betrachten. Natürlich weiß ich ganz genau, dass das Leben verschiedene Drehbücher schreibt und es uns absolut nicht immer zum Lachen ist. Wir erleben Schwierigkeiten, Trauer und Zweifel. Doch selbst in den dunkelsten Momenten können ein wenig wohlwollende Distanz, Gelassenheit und ein Lächeln wie ein Pflaster auf die verwundete Seele wirken und uns helfen, den Sturm zu überstehen. In meinem Raum ist Platz für jede deiner Emotionen – für Tränen, für Nachdenklichkeit, aber auch für befreiendes, ehrliches Lachen.</w:t></w:r></w:p><w:p w14:paraId="61153E94" w14:textId="77777777" w:rsidR="00512C39" w:rsidRPr="00F33A82" w:rsidRDefault="00512C39" w:rsidP="00512C39"><w:pPr><w:spacing w:before="100" w:beforeAutospacing="1" w:after="100" w:afterAutospacing="1" w:line="240" w:lineRule="auto"/><w:outlineLvl w:val="2"/><w:rPr><w:rFonts w:ascii="Times New Roman" w:eastAsia="Times New Roman" w:hAnsi="Times New Roman"/><w:b/><w:bCs/><w:color w:val="auto"/><w:sz w:val="27"/><w:szCs w:val="27"/><w:u w:val="none"/><w:lang w:eastAsia="de-DE"/></w:rPr></w:pPr><w:r w:rsidRPr="00F33A82"><w:rPr><w:rFonts w:ascii="Times New Roman" w:eastAsia="Times New Roman" w:hAnsi="Times New Roman"/><w:b/><w:bCs/><w:color w:val="auto"/><w:sz w:val="27"/><w:szCs w:val="27"/><w:u w:val="none"/><w:lang w:eastAsia="de-DE"/></w:rPr><w:t>Meine Mission für dich</w:t></w:r></w:p><w:p w14:paraId="070E91E1" w14:textId="77777777" w:rsidR="00512C39" w:rsidRPr="00F33A82" w:rsidRDefault="00512C39" w:rsidP="00512C39"><w:pPr><w:spacing w:before="100" w:beforeAutospacing="1" w:after="100" w:afterAutospacing="1" w:line="240" w:lineRule="auto"/><w:rPr><w:rFonts w:ascii="Times New Roman" w:eastAsia="Times New Roman" w:hAnsi="Times New Roman"/><w:color w:val="auto"/><w:sz w:val="24"/><w:szCs w:val="24"/><w:u w:val="none"/><w:lang w:eastAsia="de-DE"/></w:rPr></w:pPr><w:r w:rsidRPr="00F33A82"><w:rPr><w:rFonts w:ascii="Times New Roman" w:eastAsia="Times New Roman" w:hAnsi="Times New Roman"/><w:color w:val="auto"/><w:sz w:val="24"/><w:szCs w:val="24"/><w:u w:val="none"/><w:lang w:eastAsia="de-DE"/></w:rPr><w:t xml:space="preserve">Heute verbinde ich analytische Präzision mit Intuition und Empathie und helfe Frauen wie dir dabei, ihre eigene, einzigartige Lebenslandkarte zu entdecken. </w:t></w:r></w:p><w:p w14:paraId="54FF1D9C" w14:textId="357AE4A0" w:rsidR="00512C39" w:rsidRPr="00F33A82" w:rsidRDefault="00512C39" w:rsidP="00512C39"><w:pPr><w:spacing w:before="100" w:beforeAutospacing="1" w:after="100" w:afterAutospacing="1" w:line="240" w:lineRule="auto"/><w:rPr><w:rFonts w:ascii="Times New Roman" w:eastAsia="Times New Roman" w:hAnsi="Times New Roman"/><w:color w:val="auto"/><w:sz w:val="24"/><w:szCs w:val="24"/><w:u w:val="none"/><w:lang w:eastAsia="de-DE"/></w:rPr></w:pPr><w:r w:rsidRPr="00F33A82"><w:rPr><w:rFonts w:ascii="Times New Roman" w:eastAsia="Times New Roman" w:hAnsi="Times New Roman"/><w:color w:val="auto"/><w:sz w:val="24"/><w:szCs w:val="24"/><w:u w:val="none"/><w:lang w:eastAsia="de-DE"/></w:rPr><w:t xml:space="preserve">Ich bin fest davon überzeugt, dass unsere Beziehungen viel einfacher werden, wenn wir beginnen, die Mechanismen besser zu verstehen, die uns und die Menschen in unserem Umfeld bestimmen. Wir hören auf, die Absichten anderer zu erraten, und beginnen, uns für </w:t></w:r><w:r w:rsidR="009A3DAD" w:rsidRPr="00F33A82"><w:rPr><w:rFonts w:ascii="Times New Roman" w:eastAsia="Times New Roman" w:hAnsi="Times New Roman"/><w:color w:val="auto"/><w:sz w:val="24"/><w:szCs w:val="24"/><w:u w:val="none"/><w:lang w:eastAsia="de-DE"/></w:rPr><w:t>gegenseitiges Verständnis zu öffnen</w:t></w:r><w:r w:rsidRPr="00F33A82"><w:rPr><w:rFonts w:ascii="Times New Roman" w:eastAsia="Times New Roman" w:hAnsi="Times New Roman"/><w:color w:val="auto"/><w:sz w:val="24"/><w:szCs w:val="24"/><w:u w:val="none"/><w:lang w:eastAsia="de-DE"/></w:rPr><w:t xml:space="preserve">. Dann verschwindet das quälende Gefühl </w:t></w:r><w:r w:rsidR="009A3DAD" w:rsidRPr="00F33A82"><w:rPr><w:rFonts w:ascii="Times New Roman" w:eastAsia="Times New Roman" w:hAnsi="Times New Roman"/><w:color w:val="auto"/><w:sz w:val="24"/><w:szCs w:val="24"/><w:u w:val="none"/><w:lang w:eastAsia="de-DE"/></w:rPr><w:t xml:space="preserve">der Einsamkeit </w:t></w:r><w:r w:rsidRPr="00F33A82"><w:rPr><w:rFonts w:ascii="Times New Roman" w:eastAsia="Times New Roman" w:hAnsi="Times New Roman"/><w:color w:val="auto"/><w:sz w:val="24"/><w:szCs w:val="24"/><w:u w:val="none"/><w:lang w:eastAsia="de-DE"/></w:rPr><w:t xml:space="preserve">und weicht der Authentizität, und der Mut, über die eigenen Bedürfnisse zu sprechen, wird zu deinem natürlichen Zustand und zur Grundlage </w:t></w:r><w:r w:rsidR="009A3DAD" w:rsidRPr="00F33A82"><w:rPr><w:rFonts w:ascii="Times New Roman" w:eastAsia="Times New Roman" w:hAnsi="Times New Roman"/><w:color w:val="auto"/><w:sz w:val="24"/><w:szCs w:val="24"/><w:u w:val="none"/><w:lang w:eastAsia="de-DE"/></w:rPr><w:t>deines Alltags</w:t></w:r><w:r w:rsidRPr="00F33A82"><w:rPr><w:rFonts w:ascii="Times New Roman" w:eastAsia="Times New Roman" w:hAnsi="Times New Roman"/><w:color w:val="auto"/><w:sz w:val="24"/><w:szCs w:val="24"/><w:u w:val="none"/><w:lang w:eastAsia="de-DE"/></w:rPr><w:t xml:space="preserve">. </w:t></w:r></w:p><w:p w14:paraId="5A1FBE57" w14:textId="77777777" w:rsidR="00512C39" w:rsidRPr="00F33A82" w:rsidRDefault="00512C39" w:rsidP="00512C39"><w:pPr><w:spacing w:before="100" w:beforeAutospacing="1" w:after="100" w:afterAutospacing="1" w:line="240" w:lineRule="auto"/><w:rPr><w:rFonts w:ascii="Times New Roman" w:eastAsia="Times New Roman" w:hAnsi="Times New Roman"/><w:color w:val="auto"/><w:sz w:val="24"/><w:szCs w:val="24"/><w:u w:val="none"/><w:lang w:eastAsia="de-DE"/></w:rPr></w:pPr><w:r w:rsidRPr="00F33A82"><w:rPr><w:rFonts w:ascii="Times New Roman" w:eastAsia="Times New Roman" w:hAnsi="Times New Roman"/><w:color w:val="auto"/><w:sz w:val="24"/><w:szCs w:val="24"/><w:u w:val="none"/><w:lang w:eastAsia="de-DE"/></w:rPr><w:t xml:space="preserve">Du musst nicht mehr im Dunkeln tappen. Deine Zahlen und deine Emotionen tragen die Antworten, die du suchst, um endlich tief durchatmen und jeden Teil von dir selbst mit Zärtlichkeit annehmen zu können. </w:t></w:r></w:p><w:p w14:paraId="0ED5F330" w14:textId="46A19C6D" w:rsidR="00512C39" w:rsidRPr="00512C39" w:rsidRDefault="00512C39" w:rsidP="00512C39"><w:pPr><w:spacing w:before="100" w:beforeAutospacing="1" w:after="100" w:afterAutospacing="1" w:line="240" w:lineRule="auto"/><w:rPr><w:rFonts w:ascii="Times New Roman" w:eastAsia="Times New Roman" w:hAnsi="Times New Roman"/><w:color w:val="auto"/><w:sz w:val="24"/><w:szCs w:val="24"/><w:u w:val="none"/><w:lang w:eastAsia="de-DE"/></w:rPr></w:pPr><w:r w:rsidRPr="00F33A82"><w:rPr><w:rFonts w:ascii="Times New Roman" w:eastAsia="Times New Roman" w:hAnsi="Times New Roman"/><w:color w:val="auto"/><w:sz w:val="24"/><w:szCs w:val="24"/><w:u w:val="none"/><w:lang w:eastAsia="de-DE"/></w:rPr><w:t xml:space="preserve">Mach es dir in meiner App gemütlich und lass dich von mir durch deine eigenen Numeronarrationen führen. </w:t></w:r></w:p><w:p w14:paraId="21A67185" w14:textId="77777777" w:rsidR="00264033" w:rsidRDefault="00264033"/><w:sectPr w:rsidR="00264033" w:rsidSect="00BF001C"><w:pgSz w:w="11906" w:h="16838" w:code="9"/><w:pgMar w:top="1418" w:right="1418" w:bottom="1134" w:left="1418" w:header="284" w:footer="567" w:gutter="0"/><w:cols w:space="708"/><w:docGrid w:linePitch="360"/></w:sectPr></w:body></w:document>